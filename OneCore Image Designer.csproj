<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>OneCore_Image_Designer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;x86;ARM64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\banner.png" />
    <!-- 设备布局内置模板 + 按 Windows 系统 build 归档的官方校验规则（非 ADK 版本）：随输出目录发布，运行时按路径加载 -->
    <None Include="Assets\Templates\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\ValidationRules\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="RawDiskLib" Version="0.2.1" />
    <PackageReference Include="LTRData.DiscUtils" Version="1.0.55" />
    <!-- CbsSafety 用它判定目标卷是否由 VHD/VHDX 支撑（强制门禁） -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="MobilePackageGen\MobilePackageGen.Common\MobilePackageGen.Common.csproj" />
    <ProjectReference Include="MobilePackageGen\CbsTools\CbsTools.csproj" />
    <ProjectReference Include="UupBridge\UupBridge.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="UupShared\UupShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MobilePackageGen\**\*.cs" />
    <Compile Remove="Source\**\*.cs" />
    <Compile Remove="UupBridge\**\*.cs" />
    <Compile Remove="UupShared\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="ThirdParty\**\*.cs" />
    <Compile Remove="AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Tools\wcpex\wcpex.exe" />
    <EmbeddedResource Include="Tools\wcpex\wcp.dll" />
    <EmbeddedResource Include="Services\guids.csv" />
    <!-- 官方 ADK featureapi.dll 内嵌的 OEMInput schema，用于真实校验。无后缀=20348 基线；
         带 build 区间后缀=按目标 build 选择的 schema 家族（41 个 featureapi 哈希归组实证，见 Services/OemInputSchemaFamilyService.cs） -->
    <EmbeddedResource Include="Schemas\OEMInput.V1.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V2.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V1.10527-14959.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V1.14986-17040.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V1.17047-17125.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V1.17666-18362.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V1.18890-18941.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V1.18963.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V2.18963.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V2.18985-19041.xsd" />
    <EmbeddedResource Include="Schemas\OEMInput.V2.22621.xsd" />
  </ItemGroup>

  <!-- 内置微软 iot-adk-addonkit 17763-v7：整目录拷入输出 addonkit\；
       运行时下载的 ADK 工具落在 addonkit\adk\（本目标只增改不删，保留已装工具） -->
  <Target Name="CopyAddonKitToOutput" AfterTargets="Build">
    <ItemGroup>
      <AddonKitSource Include="$(MSBuildProjectDirectory)\addonkit\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AddonKitSource)"
          DestinationFiles="@(AddonKitSource->'$(OutDir)addonkit\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyUupBridgeToOutput" AfterTargets="Build">
    <ItemGroup>
      <UupBridgeOutput Include="$(MSBuildProjectDirectory)\UupBridge\bin\$(Configuration)\net8.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UupBridgeOutput)"
          DestinationFiles="@(UupBridgeOutput->'$(OutDir)UupBridge\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
