<Window x:Class="OneCore_Image_Designer.Views.TaskLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务日志" Height="560" Width="860" MinHeight="280" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource IcdStartBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TxtState" Text="运行中…" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource ICDBlue}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtFile" FontSize="11" Foreground="{StaticResource ICDSubText}"
                       VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White">
            <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"/>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <CheckBox x:Name="ChkAutoScroll" Content="自动滚动" IsChecked="True" DockPanel.Dock="Left"
                      VerticalAlignment="Center"/>
            <Button Content="复制全部" Click="Copy_Click" DockPanel.Dock="Right" Padding="14,5" Margin="8,0,0,0"/>
            <Button Content="打开日志文件" Click="OpenFile_Click" DockPanel.Dock="Right" Padding="14,5" Margin="8,0,0,0"/>
            <Button Content="清空显示" Click="Clear_Click" DockPanel.Dock="Right" Padding="14,5" Margin="8,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
