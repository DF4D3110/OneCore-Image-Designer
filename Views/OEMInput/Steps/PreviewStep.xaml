<UserControl x:Class="OneCore_Image_Designer.Views.OEMInput.Steps.PreviewStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="步骤 5: 预览与生成" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ICDBlue}" Margin="0,0,0,8"/>
            <TextBlock Text="预览生成的 OEMInput.xml，验证通过后保存" FontSize="12" Foreground="{StaticResource ICDSubText}" Margin="0,0,0,12"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- XML 预览 -->
            <Border Grid.Column="0" Style="{StaticResource ICDCard}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF2D2D30" Padding="10,6">
                        <TextBlock Text="OEMInput.xml" FontSize="11" Foreground="#FFCCCCCC"/>
                    </Border>
                    <TextBox Text="{Binding Parent.PreviewXml}"
                             FontFamily="Consolas" FontSize="11" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                             IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="12"/>
                </DockPanel>
            </Border>

            <!-- 验证信息 -->
            <Border Grid.Column="2" Style="{StaticResource ICDCard}">
                <StackPanel>
                    <TextBlock Text="验证结果" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Parent.ValidationSummary}" FontSize="10"
                               Foreground="{StaticResource ICDSubtle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Border x:Name="ValidationBorder" Padding="10,8" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFE8F5E9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Parent.HasValidationErrors}" Value="True">
                                        <Setter Property="Background" Value="#FFFDECEA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Parent.ValidationErrors}"
                                   FontSize="11" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF2E7D32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Parent.HasValidationErrors}" Value="True">
                                            <Setter Property="Foreground" Value="#FFC62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button Content="💾 保存 OEMInput.xml" Style="{StaticResource ICDButton}" Margin="0,16,0,0" Padding="12,10"
                            Command="{Binding Parent.SaveOEMInputCommand}"/>

                    <Border Background="#FFF0F8FF" Padding="10,8" CornerRadius="4" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="构建命令（参考）" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ICDDarkBlue}" Margin="0,0,0,4"/>
                            <TextBlock Text="imageapp.exe output.ffu OEMInput.xml MSPackageRoot /CPUType:arm64" FontSize="10" Foreground="{StaticResource ICDText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
