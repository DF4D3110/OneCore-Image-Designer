<UserControl x:Class="OneCore_Image_Designer.Views.ImageBuild.ImageBuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="← 返回" Style="{StaticResource ICDSecondaryButton}" DockPanel.Dock="Left" Padding="12,6"
                    Command="{Binding GoBackCommand}"/>
            <TextBlock Text="镜像构建" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ICDBlue}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 主内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- OS包目录 -->
                <Border Style="{StaticResource ICDCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="OS 包根目录" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="浏览..." Style="{StaticResource ICDButton}" DockPanel.Dock="Right" Padding="12,6"
                                    Command="{Binding BrowseOSPackageDirCommand}"/>
                            <TextBox Text="{Binding OSPackageDir, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource ICDSubText}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run>必需路径: </Run>
                            <Run Text="{Binding RetailArchFrePath, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" FontWeight="Bold" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRetailPathValid}" Value="True">
                                            <Setter Property="Text" Value="✓ 路径有效"/>
                                            <Setter Property="Foreground" Value="#FF2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRetailPathValid}" Value="False">
                                            <Setter Property="Text" Value="✗ 路径不存在"/>
                                            <Setter Property="Foreground" Value="#FFC62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- OEMInput + 构建工具 -->
                <Border Style="{StaticResource ICDCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="构建文件" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                        <!-- OEMInput -->
                        <TextBlock Text="OEMInput.xml" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button Content="浏览..." Style="{StaticResource ICDButton}" DockPanel.Dock="Right" Padding="12,6"
                                    Command="{Binding BrowseOEMInputCommand}"/>
                            <TextBox Text="{Binding OEMInputPath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"/>
                        </DockPanel>

                        <!-- 构建工具类型选择 -->
                        <TextBlock Text="构建工具类型" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding BuildTools}" SelectedItem="{Binding SelectedBuildTool}"
                                  Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                        <!-- 构建工具路径 -->
                        <TextBlock Text="{Binding BuildToolLabel}" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button Content="浏览..." Style="{StaticResource ICDButton}" DockPanel.Dock="Right" Padding="12,6"
                                    Command="{Binding BrowseBuildToolCommand}"/>
                            <TextBox Text="{Binding BuildToolPath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"/>
                        </DockPanel>

                        <!-- 构建方式说明 -->
                        <Border Background="#FFF0F8FF" Padding="10,8" CornerRadius="4" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource ICDDarkBlue}" Margin="0,0,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImageApp}" Value="True">
                                                    <Setter Property="Text" Value="imageapp.exe 方式: 直接运行, /CPUType:&lt;架构&gt; (原始大小写)"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsImageApp}" Value="False">
                                                    <Setter Property="Text" Value="imggen.cmd 方式: 通过 cmd.exe /k 启动, 架构用小写"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="{StaticResource ICDSubText}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImageApp}" Value="True">
                                                    <Setter Property="Text" Value="命令: imageapp.exe &quot;&lt;output&gt;&quot; &quot;&lt;OEMInput&gt;&quot; &quot;&lt;pkgDir&gt;&quot; +StrictSettingPolicies /CPUType:&lt;架构&gt;"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsImageApp}" Value="False">
                                                    <Setter Property="Text" Value="命令: imggen.cmd &quot;&lt;output&gt;&quot; &quot;&lt;OEMInput&gt;&quot; &quot;&lt;pkgDir&gt;&quot; &lt;小写架构&gt;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 架构 + 输出类型 + 输出路径 -->
                <Border Style="{StaticResource ICDCard}">
                    <StackPanel>
                        <TextBlock Text="构建配置" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CPU 架构" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture}"
                                          Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="输出文件类型" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding OutputTypes}" SelectedItem="{Binding SelectedOutputType}"
                                          Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="输出文件路径" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button Content="浏览..." Style="{StaticResource ICDButton}" DockPanel.Dock="Right" Padding="12,6"
                                    Command="{Binding BrowseOutputCommand}"/>
                            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部构建按钮 -->
        <Border Grid.Row="2" Background="#FFF0F8FF" Padding="12,8" CornerRadius="4" Margin="0,12,0,0">
            <DockPanel>
                <Button Content="开始构建" FontSize="14" FontWeight="Bold" Padding="32,10"
                        DockPanel.Dock="Right"
                        Command="{Binding StartBuildCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ICDButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBuilding}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content" Value="构建中..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding BuildStatus}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ICDBlue}"/>
                    <TextBlock Text="提示: 构建将以管理员权限在新控制台窗口中运行，请留意弹出的 UAC 提示和构建窗口。" FontSize="11" Foreground="{StaticResource ICDSubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
