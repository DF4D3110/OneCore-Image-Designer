<UserControl x:Class="OneCore_Image_Designer.Views.CatalogDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource IcdStartBackground}">
        <Grid Margin="28" MaxWidth="1600" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Microsoft 更新目录下载" FontSize="26" FontWeight="Light"
                           Foreground="{StaticResource ICDTitleForeground}"/>
                <TextBlock Text="查询 Microsoft Update Catalog，下载 MSU/CAB 更新包并准备离线镜像使用。"
                           Foreground="{StaticResource ICDSubtle}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource ICDCard}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3">
                        <TextBlock Text="关键词" Foreground="{StaticResource ICDSubtle}"/>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                 ToolTip="例如 KB5065426、Windows 11 24H2 x64"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,10,8,0"><TextBlock Text="操作系统" Foreground="{StaticResource ICDSubtle}"/><ComboBox ItemsSource="{Binding OperatingSystemChoices}" SelectedItem="{Binding OperatingSystem}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,10,8,0"><TextBlock Text="架构" Foreground="{StaticResource ICDSubtle}"/><ComboBox ItemsSource="{Binding ArchitectureChoices}" SelectedItem="{Binding Architecture}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,10,0,0"><TextBlock Text="版本/发布" Foreground="{StaticResource ICDSubtle}"/><TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="更新类型" Foreground="{StaticResource ICDSubtle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding UpdateTypeChoices}" SelectedItem="{Binding UpdateType}" Width="150" Margin="0,0,12,0"/>
                        <CheckBox Content="包含 Preview 更新" IsChecked="{Binding IncludePreview}" Margin="0,0,18,0"/>
                        <Button Content="查询" Command="{Binding SearchCatalogCommand}" Style="{StaticResource ICDToolbarPrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource ICDToolbarButton}"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource ICDAccentDark}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2" MinHeight="400">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource ICDCard}" Margin="0,0,14,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="查询结果" FontSize="16" Foreground="{StaticResource ICDTitleForeground}"/>
                            <TextBlock Text="{Binding ResultCountText}" DockPanel.Dock="Right" Foreground="{StaticResource ICDSubtle}"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Updates}" SelectedItem="{Binding SelectedUpdate}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2.4*"/>
                                <DataGridTextColumn Header="产品" Binding="{Binding Products}" Width="1.2*"/>
                                <DataGridTextColumn Header="分类" Binding="{Binding Classification}" Width="1.1*"/>
                                <DataGridTextColumn Header="日期" Binding="{Binding DateDisplay}" Width="*"/>
                                <DataGridTextColumn Header="文件" Binding="{Binding FileSummary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource ICDCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="文件明细与下载" FontSize="16" Foreground="{StaticResource ICDTitleForeground}"/>
                            <TextBlock Text="{Binding SelectedUpdate.Title}" TextWrapping="Wrap" Margin="0,8,0,8" FontWeight="SemiBold"/>
                            <ListBox ItemsSource="{Binding Files}" Height="130">
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Url}"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="输出目录" Foreground="{StaticResource ICDSubtle}" Margin="0,10,0,3"/>
                            <DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseOutputDirectoryCommand}" Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,0"/><TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                            <CheckBox Content="覆盖已有文件" IsChecked="{Binding Overwrite}" Margin="0,8,0,0"/>
                            <CheckBox Content="下载该更新的全部文件" IsChecked="{Binding DownloadAllFiles}" Margin="0,4,0,8"/>
                            <Button Content="下载所选文件" Command="{Binding DownloadCommand}" Style="{StaticResource ICDToolbarPrimaryButton}" HorizontalAlignment="Left"/>
                            <ProgressBar Value="{Binding Progress}" Height="4" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding EngineName}" Foreground="{StaticResource ICDAccentDark}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ICDCard}">
                        <StackPanel><TextBlock Text="日志" FontSize="16" Foreground="{StaticResource ICDTitleForeground}" Margin="0,0,0,6"/><TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" MinHeight="180"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
