<UserControl x:Class="OneCore_Image_Designer.Views.CatalogDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <Grid Background="{StaticResource IcdStartBackground}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Microsoft 更新目录下载" FontSize="24" FontWeight="Light"
                           Foreground="{StaticResource ICDTitleForeground}"/>
                <TextBlock Text="支持 Windows 2000 / XP / Server、Office、SQL Server、Visual Studio、.NET、驱动等 Catalog 产品。"
                           Foreground="{StaticResource ICDSubtle}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding EngineName}" Foreground="{StaticResource ICDAccentDark}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="打开操作日志" Command="{Binding ShowLogCommand}"
                        Style="{StaticResource ICDToolbarButton}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource ICDCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="5">
                    <TextBlock Text="关键词（可输入 KB、版本、产品名称或完整 Catalog 标题）"
                               Foreground="{StaticResource ICDSubtle}"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,0" ToolTip="例如 KB5065426、Office 2010、SQL Server 2012、Windows XP x64"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,8,8,0">
                    <TextBlock Text="产品范围" Foreground="{StaticResource ICDSubtle}"/>
                    <ComboBox ItemsSource="{Binding ProductFamilyChoices}" SelectedItem="{Binding ProductFamily}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,8,8,0">
                    <TextBlock Text="系统 / 产品版本" Foreground="{StaticResource ICDSubtle}"/>
                    <ComboBox ItemsSource="{Binding OperatingSystemChoices}" SelectedItem="{Binding OperatingSystem}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,8,8,0">
                    <TextBlock Text="架构" Foreground="{StaticResource ICDSubtle}"/>
                    <ComboBox ItemsSource="{Binding ArchitectureChoices}" SelectedItem="{Binding Architecture}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,8,8,0">
                    <TextBlock Text="版本 / Build / 类型" Foreground="{StaticResource ICDSubtle}"/>
                    <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,8,0,0">
                    <CheckBox Content="Preview" IsChecked="{Binding IncludePreview}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="查询" Command="{Binding SearchCatalogCommand}"
                            Style="{StaticResource ICDToolbarPrimaryButton}" Margin="0,0,6,0"/>
                    <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource ICDToolbarButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ICDCard}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                        <TextBlock Text="查询结果" FontSize="16" Foreground="{StaticResource ICDTitleForeground}"/>
                        <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="{StaticResource ICDSubtle}"
                                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Updates}" SelectedItem="{Binding SelectedUpdate}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" EnableRowVirtualization="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2.5*"/>
                            <DataGridTextColumn Header="产品" Binding="{Binding Products}" Width="1.4*"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Classification}" Width="1.2*"/>
                            <DataGridTextColumn Header="日期" Binding="{Binding DateDisplay}" Width="*"/>
                            <DataGridTextColumn Header="文件" Binding="{Binding FileSummary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ICDCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="文件明细与下载" FontSize="16" Foreground="{StaticResource ICDTitleForeground}"/>
                        <TextBlock Text="{Binding SelectedUpdate.Title}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Margin="0,6,0,5" MaxHeight="42"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Files}" MinHeight="70"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Url}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseOutputDirectoryCommand}"
                                    Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,7">
                            <CheckBox Content="覆盖已有文件" IsChecked="{Binding Overwrite}" Margin="0,0,16,0"/>
                            <CheckBox Content="下载全部文件" IsChecked="{Binding DownloadAllFiles}"/>
                        </StackPanel>
                        <DockPanel Grid.Row="2">
                            <Button Content="下载" Command="{Binding DownloadCommand}"
                                    Style="{StaticResource ICDToolbarPrimaryButton}" DockPanel.Dock="Right"/>
                            <ProgressBar Value="{Binding Progress}" Height="4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
