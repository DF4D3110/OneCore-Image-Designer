<UserControl x:Class="OneCore_Image_Designer.Views.UupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource IcdStartBackground}">
        <Grid Margin="24" MaxWidth="1600" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="UUP 更新中心" FontSize="27" FontWeight="Light"
                               Foreground="{StaticResource ICDTitleForeground}"/>
                    <TextBlock Text="查询 Windows 更新，选择目标版本并下载到本地。联网操作只会在你主动启动后执行。"
                               Margin="0,5,0,0" Foreground="{StaticResource ICDSubtle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="载入快照…" Command="{Binding OpenSnapshotCommand}"
                            Style="{StaticResource ICDToolbarButton}" Margin="0,0,8,0"/>
                    <Button Content="操作日志" Command="{Binding ShowLogCommand}"
                            Style="{StaticResource ICDToolbarButton}"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource ICDCard}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="更新查询" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource ICDTitleForeground}"/>
                            <TextBlock Text="按产品线和架构扫描正式版与 Insider 更新；查询设备版本、通道和分支可在高级选项中填写，目标 NT Build 可选。"
                                       Margin="0,3,0,0" Foreground="{StaticResource ICDSubtle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}"
                                   Foreground="{StaticResource ICDAccentDark}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360" Margin="16,0,0,0"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="上报 SKU" Foreground="{StaticResource ICDSubtle}"/>
                            <ComboBox ItemsSource="{Binding ReportingSkuChoices}" SelectedValuePath="Name"
                                      DisplayMemberPath="DisplayName" SelectedValue="{Binding SelectedSku}"
                                      IsEditable="False" IsTextSearchEnabled="True" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="架构" Foreground="{StaticResource ICDSubtle}"/>
                            <ComboBox ItemsSource="{Binding ArchitectureChoices}"
                                      SelectedItem="{Binding SelectedArchitecture}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="目标 NT 版本（可选；留空显示全部扫描结果）"
                                       Foreground="{StaticResource ICDSubtle}"/>
                            <TextBox Text="{Binding TargetBuildFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     ToolTip="仅在本地筛选目标更新，不会改变 UUP 查询设备基线或服务端请求参数。"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="扫描更新" Command="{Binding ScanCommand}"
                                        Style="{StaticResource ICDToolbarPrimaryButton}" Margin="0,0,8,0"/>
                                <Button Content="取消" Command="{Binding CancelCommand}"
                                        Style="{StaticResource ICDToolbarButton}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Expander Grid.Row="3" Header="高级查询选项（均可留空或不勾选）"
                              IsExpanded="False" Margin="0,12,0,0">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,8,8">
                                <TextBlock Text="查询设备版本（可选；留空自动匹配各分支常用版本）"
                                           Foreground="{StaticResource ICDSubtle}"/>
                                <TextBox Text="{Binding ReportingVersion, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,3,0,0"
                                         ToolTip="这是查询设备的上报版本，不是目标 NT Build。"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="更新通道 / Flight Ring（可选）"
                                           Foreground="{StaticResource ICDSubtle}"/>
                                <ComboBox ItemsSource="{Binding FlightRingChoices}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedFlightRing}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,8,8">
                                <TextBlock Text="当前分支（可选，例如 ge_release）"
                                           Foreground="{StaticResource ICDSubtle}"/>
                                <TextBox Text="{Binding CurrentBranch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Insider Flighting 分支（可选）"
                                           Foreground="{StaticResource ICDSubtle}"/>
                                <TextBox Text="{Binding SelectedFlightingBranch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,3,0,0"
                                         ToolTip="例如 ReleasePreview、Beta、Dev 或 CanaryChannel；留空不指定。"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <CheckBox Content="仅查询当前上报版本"
                                          IsChecked="{Binding SyncCurrentVersionOnly}"
                                          Margin="0,0,18,0"/>
                                <CheckBox Content="正式发布 (ProductRelease)"
                                          IsChecked="{Binding IncludeProductRelease}"
                                          Margin="0,0,18,0"/>
                                <CheckBox Content="Insider 航班 (OSFlight)"
                                          IsChecked="{Binding IncludeOsFlight}"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Grid>
            </Border>

            <Grid Grid.Row="2" MinHeight="330">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ICDCard}" Margin="0,0,12,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="可用更新" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource ICDTitleForeground}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ResultCountText}"
                                           Foreground="{StaticResource ICDSubtle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="标题关键词"
                                               Foreground="{StaticResource ICDSubtle}"/>
                                    <TextBox Text="{Binding TitleKeywordFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,3,0,0" ToolTip="按更新标题进行不区分大小写的包含匹配。"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="NT 版本与标题关键词只过滤已扫描/载入的结果，不会改变 Microsoft 查询参数。"
                                       Margin="0,5,0,0" Foreground="{StaticResource ICDSubtle}"
                                       TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Text="{Binding QuerySummaryText}" Margin="0,5,0,0"
                                       Foreground="{StaticResource ICDAccentDark}"
                                       TextWrapping="Wrap" FontSize="11"/>
                            <Expander Header="扫描组合明细" Margin="0,6,0,0">
                                <DataGrid ItemsSource="{Binding Snapshot.QueryProfiles}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" Height="118"
                                          HeadersVisibility="Column" EnableRowVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="查询组合" Binding="{Binding Profile}" Width="2.4*"/>
                                        <DataGridTextColumn Header="返回" Binding="{Binding ResultCount}" Width="*"/>
                                        <DataGridTextColumn Header="新增" Binding="{Binding NewCount}" Width="*"/>
                                        <DataGridTextColumn Header="跳过" Binding="{Binding SkippedCount}" Width="*"/>
                                        <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </StackPanel>
                        <Grid>
                            <DataGrid ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding SelectedEntry}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" SelectionMode="Single"
                                      SelectionUnit="FullRow" EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="更新名称" Binding="{Binding Title}" Width="2.2*"/>
                                    <DataGridTextColumn Header="目标 Build" Binding="{Binding Build}" Width="*"/>
                                    <DataGridTextColumn Header="版本" Binding="{Binding ReleaseVersion}" Width="*"/>
                                    <DataGridTextColumn Header="通道" Binding="{Binding FlightRing}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding Filter}" Width="*"/>
                                    <DataGridTextColumn Header="发布日期" Binding="{Binding ServerDate}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="420" Margin="24"
                                        Visibility="{Binding HasVisibleEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        IsHitTestVisible="False">
                                <TextBlock Text="{Binding EmptyResultsMessage}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource ICDTitleForeground}"
                                           TextAlignment="Center"/>
                                <TextBlock Text="选择 SKU 和架构后扫描，或载入快照；也可以清除本地筛选条件。"
                                           Margin="0,6,0,0" Foreground="{StaticResource ICDSubtle}"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource ICDCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="下载所选更新" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource ICDTitleForeground}"/>
                            <TextBlock Text="{Binding SelectedEntry.Title}" TextWrapping="Wrap"
                                       Margin="0,10,0,4" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedEntry.UpdateId}"
                                       Foreground="{StaticResource ICDSubtle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedEntry.Description}" TextWrapping="Wrap"
                                       Foreground="{StaticResource ICDSubtle}" Margin="0,8,0,0"
                                       MaxHeight="120"/>
                            <TextBlock Text="{Binding SelectedEntry.DetailsSummary}" TextWrapping="Wrap"
                                       Foreground="{StaticResource ICDSubtle}" Margin="0,8,0,0"/>
                            <TextBlock Text="下载语言（选择更新后加载具体语言）" Foreground="{StaticResource ICDSubtle}"
                                       Margin="0,12,0,0"/>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="重新读取"
                                        Command="{Binding ReloadAvailableLanguagesCommand}"
                                        Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,0"/>
                                <ComboBox ItemsSource="{Binding AvailableDownloadLanguages}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                          SelectedValue="{Binding SelectedDownloadLanguage}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding DownloadLanguageStatus}" Foreground="{StaticResource ICDSubtle}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="保存位置" Foreground="{StaticResource ICDSubtle}"
                                       Margin="0,14,0,0"/>
                            <DockPanel Margin="0,4,0,10">
                                <Button DockPanel.Dock="Right" Content="浏览…"
                                        Command="{Binding BrowseOutputDirectoryCommand}"
                                        Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding OutputDirectory}"/>
                            </DockPanel>
                            <Button Content="下载所选更新" Command="{Binding DownloadSelectedCommand}"
                                    Style="{StaticResource ICDToolbarPrimaryButton}"
                                    HorizontalAlignment="Left"/>
                            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,12,0,0"/>
                            <TextBlock Text="下载在后台进程执行；进度和诊断信息会显示在独立日志窗口。"
                                       Foreground="{StaticResource ICDSubtle}" TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ICDCard}">
                        <StackPanel>
                            <TextBlock Text="当前快照" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource ICDTitleForeground}"/>
                            <TextBlock Text="{Binding SnapshotPath}" TextWrapping="Wrap"
                                       Foreground="{StaticResource ICDSubtle}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Snapshot.ScanTime, StringFormat='扫描时间：{0:G}'}"
                                       Foreground="{StaticResource ICDSubtle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Expander Grid.Row="3" Header="UUP 转 ISO（可选）" IsExpanded="False"
                      Margin="0,14,0,0" Background="{StaticResource ICDSurface}">
                <Border Style="{StaticResource ICDCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="使用随程序构建的 UUPMediaConverter 源码功能，将已下载文件转换为 ISO；无需选择转换器 EXE。需安装 .NET 10 运行时；启动前会检查输入、目标路径和磁盘空间，日志输出到独立窗口。"
                                   TextWrapping="Wrap" Foreground="{StaticResource ICDSubtle}"
                                   Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,8,8">
                                <TextBlock Text="已下载 UUP 文件目录" Foreground="{StaticResource ICDSubtle}"/>
                                <TextBox Text="{Binding ConversionInputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Row="0" Grid.Column="2" Content="选择输入…"
                                    Command="{Binding BrowseConversionInputCommand}"
                                    Style="{StaticResource ICDToolbarButton}" Margin="0,18,0,8"/>
                            <StackPanel Grid.Row="1" Margin="0,0,8,8">
                                <TextBlock Text="ISO 输出路径（必须不存在）" Foreground="{StaticResource ICDSubtle}"/>
                                <TextBox Text="{Binding ConversionIsoPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="2" Content="选择 ISO…"
                                    Command="{Binding BrowseConversionOutputCommand}"
                                    Style="{StaticResource ICDToolbarButton}" Margin="0,18,0,8"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <StackPanel Width="300" Margin="0,0,8,0">
                                    <TextBlock Text="空的临时目录（需预先创建）"
                                               Foreground="{StaticResource ICDSubtle}"/>
                                    <TextBox Text="{Binding ConversionTemporaryDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Width="110" Margin="4,0,8,0">
                                    <TextBlock Text="语言" Foreground="{StaticResource ICDSubtle}"/>
                                    <TextBox Text="{Binding ConversionLanguageCode, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="4,0,8,0">
                                    <TextBlock Text="Edition（可选）" Foreground="{StaticResource ICDSubtle}"/>
                                    <TextBox Text="{Binding ConversionEdition, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="选择临时目录…" Command="{Binding BrowseConversionTempCommand}"
                                        Style="{StaticResource ICDToolbarButton}" Margin="4,18,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                            <Button Content="运行预检" Command="{Binding CheckConversionPreflightCommand}"
                                    Style="{StaticResource ICDToolbarButton}" Margin="0,0,8,0"/>
                            <Button Content="开始转换…" Command="{Binding StartConversionCommand}"
                                    Style="{StaticResource ICDToolbarPrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="取消转换" Command="{Binding CancelConversionCommand}"
                                    Style="{StaticResource ICDToolbarButton}"
                                    IsEnabled="{Binding IsConverting}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ConversionStatus}" Foreground="{StaticResource ICDAccentDark}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ConversionPreflightSummary}" Foreground="{StaticResource ICDSubtle}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <ItemsControl ItemsSource="{Binding ConversionChecks}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
    </ScrollViewer>
</UserControl>
