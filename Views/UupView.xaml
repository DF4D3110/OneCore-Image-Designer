<UserControl x:Class="OneCore_Image_Designer.Views.UupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource IcdStartBackground}">
    <Grid Background="{StaticResource IcdStartBackground}" Margin="28" MaxWidth="1600"
          HorizontalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="UUP 更新查询与下载" FontSize="26" FontWeight="Light" Foreground="{StaticResource ICDTitleForeground}"/>
            <TextBlock Text="通过随应用集成的 UUPMediaCreator 核心查询可用更新，再选择单个版本下载；联网操作由你主动启动。" Margin="0,6,0,18" Foreground="{StaticResource ICDSubtle}"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="上报 SKU" Foreground="{StaticResource ICDSubtle}"/>
                <ComboBox ItemsSource="{Binding ReportingSkuChoices}" SelectedValuePath="Name"
                          DisplayMemberPath="DisplayName" SelectedValue="{Binding SelectedSku}"
                          IsEditable="False" IsTextSearchEnabled="True" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                <TextBlock Text="架构" Foreground="{StaticResource ICDSubtle}"/>
                <ComboBox ItemsSource="{Binding ArchitectureChoices}" SelectedItem="{Binding SelectedArchitecture}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="4,0,8,0">
                <TextBlock Text="更新通道" Foreground="{StaticResource ICDSubtle}"/>
                <ComboBox ItemsSource="{Binding FlightRingChoices}" SelectedItem="{Binding SelectedFlightRing}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="4,0,0,0">
                <TextBlock Text="Insider 分支" Foreground="{StaticResource ICDSubtle}"/>
                <ComboBox ItemsSource="{Binding FlightingBranchChoices}" SelectedItem="{Binding SelectedFlightingBranch}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="上报版本（不是目标版本）" Foreground="{StaticResource ICDSubtle}"/>
                <TextBox Text="{Binding ReportingVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,12,0"><TextBlock Text="分支（如 ge_release / ni_release）" Foreground="{StaticResource ICDSubtle}"/>
                <TextBox Text="{Binding CurrentBranch, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="扫描可用更新" Command="{Binding ScanCommand}" Style="{StaticResource ICDToolbarPrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="载入快照…" Command="{Binding OpenSnapshotCommand}" Style="{StaticResource ICDToolbarButton}" Margin="0,0,8,0"/>
                <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource ICDToolbarButton}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                <CheckBox Content="仅查询当前上报版本" IsChecked="{Binding SyncCurrentVersionOnly}" Margin="0,0,24,0"/>
                <CheckBox Content="正式发布 (ProductRelease)" IsChecked="{Binding IncludeProductRelease}" Margin="0,0,24,0"/>
                <CheckBox Content="Insider 航班 (OSFlight)" IsChecked="{Binding IncludeOsFlight}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource ICDCard}" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource ICDAccentDark}"/>
                        <TextBlock Text="注意：README 中的上报版本是客户端当前版本基线，不是想下载的目标版本；扫描结果中的具体更新才是可选下载项。"
                                   Foreground="{StaticResource ICDSubtle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="版本 / 更新" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Build" Binding="{Binding Build}" Width="*"/>
                                <DataGridTextColumn Header="通道" Binding="{Binding FlightRing}" Width="*"/>
                                <DataGridTextColumn Header="来源" Binding="{Binding Filter}" Width="*"/>
                                <DataGridTextColumn Header="服务器日期" Binding="{Binding ServerDate}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="尚无更新列表。调整 SKU、架构和通道后，点击“扫描可用更新”。"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440"
                                   Foreground="{StaticResource ICDSubtle}" Margin="24"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource ICDCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="所选更新" FontSize="16" Foreground="{StaticResource ICDTitleForeground}"/>
                        <TextBlock Text="{Binding SelectedEntry.Title}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding SelectedEntry.UpdateId}" Foreground="{StaticResource ICDSubtle}" TextWrapping="Wrap"/>
                        <TextBlock Text="下载到" Foreground="{StaticResource ICDSubtle}" Margin="0,12,0,0"/>
                        <DockPanel Margin="0,4,0,10">
                            <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseOutputDirectoryCommand}"
                                    Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding OutputDirectory}"/>
                        </DockPanel>
                        <Button Content="下载所选更新" Command="{Binding DownloadSelectedCommand}"
                                Style="{StaticResource ICDToolbarPrimaryButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ICDCard}">
                    <StackPanel><TextBlock Text="UUP 操作日志" FontSize="16" Foreground="{StaticResource ICDTitleForeground}"/>
                    <ListBox ItemsSource="{Binding LogLines}" Margin="0,8,0,0"/></StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
