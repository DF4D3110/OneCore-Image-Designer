<Window x:Class="OneCore_Image_Designer.Views.Tools.OfflineRegistryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线注册表编辑器" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="🔧 离线注册表编辑器" FontSize="16" FontWeight="Bold" Foreground="#FF2C5AA0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtHiveInfo" Text="" FontSize="11" Foreground="#FF666666" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnSave" Content="💾 保存修改" Height="26" Padding="10,0" Click="Save_Click" Margin="4,0" IsEnabled="False" Background="#FF4CAF50" Foreground="White" BorderThickness="0"/>
                    <Button Content="📤 导出" Height="26" Padding="10,0" Click="Export_Click" Margin="4,0" IsEnabled="{Binding IsLoaded}"/>
                    <Button Content="🔍 搜索" Height="26" Padding="10,0" Click="Search_Click" Margin="4,0" IsEnabled="{Binding IsLoaded}"/>
                    <Button Content="📂 加载 Hive" Height="26" Padding="10,0" Background="#FF2C5AA0" Foreground="White" BorderThickness="0" Click="LoadHive_Click"/>
                </StackPanel>
                <CheckBox x:Name="ChkWritable" Content="可写模式" VerticalAlignment="Center" IsEnabled="True"/>
            </DockPanel>
        </Border>

        <!-- 主内容区：左侧树 + 右侧值列表 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：注册表键树 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📁 键" FontSize="11" FontWeight="Bold" Foreground="#FF2C5AA0" Margin="8,6,8,4"/>
                    <TreeView x:Name="TreeKeys" SelectedItemChanged="TreeKeys_SelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                                    <TextBlock Text=" ({Binding SubKeyCount})" FontSize="9" Foreground="#FF999999"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- 右侧：键值列表 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="TxtCurrentPath" Text="路径: \" FontSize="11" FontWeight="Bold" Foreground="#FF2C5AA0" Margin="8,6,8,4" TextTrimming="CharacterEllipsis"/>
                    <ListView x:Name="LstValues" VirtualizingStackPanel.IsVirtualizing="True"
                              MouseDoubleClick="LstValues_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="类型" Width="100" DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="数据" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Data}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 搜索结果面板 -->
        <Border Grid.Row="3" Background="#FFFFF8E1" BorderBrush="#FFFFE082" BorderThickness="1" CornerRadius="4"
                Margin="0,8,0,0" Visibility="{Binding ShowSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="🔍 搜索结果" FontSize="12" FontWeight="Bold" Foreground="#FFF57F17" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSearchCount" Text="" FontSize="11" Foreground="#FF666666" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="✕ 关闭" Height="22" Padding="8,0" Click="CloseSearchResults_Click"/>
                </DockPanel>
                <ListBox x:Name="LstSearchResults" MaxHeight="150" MouseDoubleClick="LstSearchResults_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="#FFE8E8E8" Padding="8,4" Margin="0,8,0,0" CornerRadius="2">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="11" Foreground="#FF666666" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtKeyInfo" Text="" FontSize="11" Foreground="#FF666666" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
