<Window x:Class="OneCore_Image_Designer.Views.Tools.SaveTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="另存为自定义设备布局模板"
        Width="520" Height="340" MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{StaticResource ICDSubText}"/>
            <Setter Property="Width" Value="88"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Control" x:Key="Inp">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="模板标识" Style="{StaticResource Lbl}"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtKey" Style="{StaticResource Inp}"
                     ToolTip="磁盘目录名，仅限字母数字与 . _ -，如 MyContoso-Dev"/>
            <TextBlock Grid.Row="1" Text="显示名称" Style="{StaticResource Lbl}"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtTitle" Style="{StaticResource Inp}"/>
            <TextBlock Grid.Row="2" Text="适用设备类型" Style="{StaticResource Lbl}"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDeviceType" Style="{StaticResource Inp}"/>
            <TextBlock Grid.Row="3" Text="绑定校验规则" Style="{StaticResource Lbl}"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbRule" Style="{StaticResource Inp}"
                      ToolTip="保存后，载入该模板时可用此规则校验（列表来自已提取的 ADK 官方规则）"/>
        </Grid>
        <GroupBox Grid.Row="1" Header="备注" Padding="6" Margin="0,8,0,0">
            <TextBox x:Name="TxtNotes" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
        </GroupBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Click="Cancel_Click" Padding="14,5" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="保存" Click="Ok_Click" Padding="14,5" IsDefault="True"
                    Background="{StaticResource ICDBlue}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
