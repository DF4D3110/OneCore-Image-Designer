<Window x:Class="OneCore_Image_Designer.Views.Tools.DependencyViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="包依赖关系分析器" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="🔗 包依赖关系分析器"
                   FontSize="16" FontWeight="Bold" Foreground="#FF2C5AA0" Margin="0,0,0,12"/>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="📂 选择目录并分析" Height="28" Padding="12,0"
                        Background="#FF2C5AA0" Foreground="White" BorderThickness="0"
                        Click="Analyze_Click" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="💾 导出报告" Height="28" Padding="12,0"
                        Background="#FF4CAF50" Foreground="White" BorderThickness="0"
                        Click="Export_Click"/>
                <TextBlock Text="Manifest目录:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <TextBox x:Name="TxtDirectory" Height="28" VerticalContentAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 统计信息 -->
        <Border Grid.Row="1" Background="#FFE3F2FD" BorderBrush="#FFBBDEFB" BorderThickness="1" CornerRadius="4"
                Padding="8" Margin="0,52,0,12" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="包总数" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding TotalPackages}" FontSize="18" FontWeight="Bold" Foreground="#FF2C5AA0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="依赖关系" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding TotalDependencies}" FontSize="18" FontWeight="Bold" Foreground="#FF2C5AA0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="缺失依赖" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding MissingCount}" FontSize="18" FontWeight="Bold" Foreground="#FFF44336"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="循环依赖" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding CircularCount}" FontSize="18" FontWeight="Bold" Foreground="#FFFF9800"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区：左侧包列表 + 右侧详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：包列表 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📦 包列表" FontSize="12" FontWeight="Bold"
                               Foreground="#FF2C5AA0" Margin="8,8,8,4"/>
                    <TextBox DockPanel.Dock="Top" x:Name="TxtFilter" Height="24" Margin="8,0,8,4"
                             VerticalContentAlignment="Center" FontSize="11"
                             TextChanged="TxtFilter_TextChanged" ToolTip="输入包名过滤"/>
                    <ListBox x:Name="LstPackages" SelectionChanged="LstPackages_SelectionChanged"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Version}" FontSize="9" Foreground="#FF999999"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：详情 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- 选中包信息 -->
                        <TextBlock Text="📋 包信息" FontSize="13" FontWeight="Bold" Foreground="#FF2C5AA0" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" FontSize="11" Foreground="#FF666666"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPackage.Name}" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="版本:" FontSize="11" Foreground="#FF666666"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPackage.Version}" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="架构:" FontSize="11" Foreground="#FF666666"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPackage.Architecture}" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="公钥:" FontSize="11" Foreground="#FF666666"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPackage.PublicKeyToken}" FontSize="11" FontFamily="Consolas"/>
                        </Grid>

                        <!-- 依赖列表 -->
                        <TextBlock Text="⬇️ 依赖的包" FontSize="13" FontWeight="Bold" Foreground="#FF4CAF50" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding SelectedPackage.Dependencies}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF1F8E9" BorderBrush="#FFA5D6A7" BorderThickness="1" CornerRadius="2"
                                            Padding="6,4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text=" v" FontSize="11"/>
                                                <TextBlock Text="{Binding Version}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock FontSize="9" Foreground="#FF666666">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="✅ 存在于镜像中"/>
                                                        <Setter Property="Foreground" Value="#FF4CAF50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="Text" Value="❌ 缺失 - 未在镜像中找到"/>
                                                                <Setter Property="Foreground" Value="#FFF44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 被依赖列表 -->
                        <TextBlock Text="⬆️ 被哪些包依赖" FontSize="13" FontWeight="Bold" Foreground="#FFFF9800" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding SelectedPackage.Dependents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFF3E0" BorderBrush="#FFFFCC80" BorderThickness="1" CornerRadius="2"
                                            Padding="6,4" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text=" v" FontSize="11"/>
                                            <TextBlock Text="{Binding Version}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Width="80" Height="28" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
