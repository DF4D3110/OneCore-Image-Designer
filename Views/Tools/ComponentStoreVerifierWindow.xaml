<Window x:Class="OneCore_Image_Designer.Views.Tools.ComponentStoreVerifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="组件存储完整性校验" Height="600" Width="900"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="✅ 组件存储完整性校验"
                   FontSize="16" FontWeight="Bold" Foreground="#FF2C5AA0" Margin="0,0,0,12"/>

        <!-- 输入区域 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Manifest目录:" VerticalAlignment="Center" Margin="0,0,8,4" FontSize="12"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtManifestDir" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,4"/>
                <Button Grid.Row="0" Grid.Column="2" Content="📂" Width="32" Height="28" Margin="0,0,0,4" Click="BrowseManifest_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="WinSxS目录:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtWinSxSDir" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Row="1" Grid.Column="2" Content="📂" Width="32" Height="28" Click="BrowseWinSxS_Click"/>
            </Grid>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnVerify" Content="🔍 开始校验" MinHeight="28" Padding="16,4"
                    Background="#FF2C5AA0" Foreground="White" BorderThickness="0"
                    Click="Verify_Click"/>
            <Button Content="💾 导出报告" MinHeight="28" Padding="16,4" Margin="8,0,0,0"
                    Background="#FF4CAF50" Foreground="White" BorderThickness="0"
                    Click="Export_Click"/>
            <ComboBox x:Name="CmbFilter" Width="120" MinHeight="28" Margin="16,0,0,0" VerticalContentAlignment="Center"
                    SelectionChanged="CmbFilter_SelectionChanged">
                <ComboBoxItem Content="全部" IsSelected="True"/>
                <ComboBoxItem Content="仅缺失"/>
                <ComboBoxItem Content="仅空文件夹"/>
                <ComboBoxItem Content="仅正常"/>
                <ComboBoxItem Content="仅已跳过(.inf)"/>
            </ComboBox>
        </StackPanel>

        <!-- 统计信息（独占一行；原先与按钮共用 Row 2 并靠硬编码 Margin=40 分隔，
             高 DPI 缩放下会重叠） -->
        <Border Grid.Row="3" Background="#FFE8F5E9" BorderBrush="#FFA5D6A7" BorderThickness="1" CornerRadius="4"
                Padding="8" Margin="0,0,0,8" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="组件总数" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding TotalComponents}" FontSize="16" FontWeight="Bold" Foreground="#FF2C5AA0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="正常" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding NormalCount}" FontSize="16" FontWeight="Bold" Foreground="#FF4CAF50"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="缺失" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding MissingCount}" FontSize="16" FontWeight="Bold" Foreground="#FFF44336"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="空文件夹" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding EmptyCount}" FontSize="16" FontWeight="Bold" Foreground="#FFFF9800"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="跳过(.inf)" FontSize="10" Foreground="#FF666666"
                               ToolTip=".inf 驱动类组件的哈希无法用 X65599Variant 复现，已单独归类，不计入缺失"/>
                    <TextBlock Text="{Binding InfSkippedCount}" FontSize="16" FontWeight="Bold" Foreground="#FF78909C"/>
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock Text="解析失败" FontSize="10" Foreground="#FF666666"
                               ToolTip="未能读出 assemblyIdentity 的 manifest 数量。非 0 说明有 manifest 没被成功解析（如 wcpex 不可用）"/>
                    <TextBlock Text="{Binding ParseFailedCount}" FontSize="16" FontWeight="Bold" Foreground="#FFE91E63"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="总大小" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding TotalSizeDisplay}" FontSize="14" FontWeight="Bold" Foreground="#FF2C5AA0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 结果列表 -->
        <Border Grid.Row="4" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4">
            <ListView x:Name="LstResults" VirtualizingStackPanel.IsVirtualizing="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="状态" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" FontSize="11"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="组件名" Width="250" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="版本" Width="120" DisplayMemberBinding="{Binding Version}"/>
                        <GridViewColumn Header="架构" Width="60" DisplayMemberBinding="{Binding Architecture}"/>
                        <GridViewColumn Header="文件数" Width="60" DisplayMemberBinding="{Binding FileCount}"/>
                        <GridViewColumn Header="大小" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalSize, StringFormat='{}{0:N0}'}" FontSize="11"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="期望文件夹名" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExpectedFolderName}" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" MinWidth="80" MinHeight="28" Padding="10,4" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
