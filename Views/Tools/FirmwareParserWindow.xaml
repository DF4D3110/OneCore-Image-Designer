<Window x:Class="OneCore_Image_Designer.Views.Tools.FirmwareParserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UEFI 固件解析器" Height="650" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="🔧 UEFI 固件解析器" FontSize="16" FontWeight="Bold" Foreground="#FF2C5AA0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtBuildId" Text="" FontSize="11" Foreground="#FF666666" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="💾 导出报告" Height="26" Padding="10,0" Click="ExportReport_Click" IsEnabled="{Binding HasResult}"/>
                    <Button Content="📂 选择固件" Height="26" Padding="10,0" Margin="8,0,0,0" Background="#FF2C5AA0" Foreground="White" BorderThickness="0" Click="LoadFirmware_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtFilePath" Text="未加载固件文件" FontSize="11" Foreground="#FF999999" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 统计信息 -->
        <Border Grid.Row="2" Background="#FFE3F2FD" BorderBrush="#FFBBDEFB" BorderThickness="1" CornerRadius="4"
                Padding="8" Margin="0,0,0,8" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Firmware Volume" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding VolumeCount}" FontSize="16" FontWeight="Bold" Foreground="#FF2C5AA0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="FFS 文件" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding FileCount}" FontSize="16" FontWeight="Bold" Foreground="#FF2C5AA0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Section" FontSize="10" Foreground="#FF666666"/>
                    <TextBlock Text="{Binding SectionCount}" FontSize="16" FontWeight="Bold" Foreground="#FF2C5AA0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区：左侧树 + 右侧详情 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：固件结构树 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📁 固件结构" FontSize="11" FontWeight="Bold" Foreground="#FF2C5AA0" Margin="8,6,8,4"/>
                    <TreeView x:Name="TreeFirmware" SelectedItemChanged="TreeFirmware_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                                    <TextBlock Text=" ({Binding TypeName})" FontSize="9" Foreground="#FF999999"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- 右侧：详细信息 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📋 详细信息" FontSize="11" FontWeight="Bold" Foreground="#FF2C5AA0" Margin="8,6,8,4"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock x:Name="TxtDetailTitle" Text="选择左侧节点查看详情" FontSize="12" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtDetailContent" Text="" FontSize="11" Foreground="#FF666666" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="#FFE8E8E8" Padding="8,4" Margin="0,8,0,0" CornerRadius="2">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="11" Foreground="#FF666666" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
