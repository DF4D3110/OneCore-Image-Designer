<UserControl x:Class="OneCore_Image_Designer.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:OneCore_Image_Designer.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="StartTile" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ICDSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource ICDForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ICDAccentBright}"/>
                                <Setter TargetName="border" Property="Background" Value="#FFF7FBFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ICDLightBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartTileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ICDForeground}"/>
        </Style>

        <Style x:Key="StartTileDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ICDSubtle}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="StartSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="{StaticResource ICDTitleForeground}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="StartListButton" TargetType="Button" BasedOn="{StaticResource ICDToolbarButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Width" Value="250"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource IcdStartBackground}">
        <Grid MaxWidth="1180" HorizontalAlignment="Center" Margin="42,30,42,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="OneCore Image Designer" FontSize="27" FontWeight="Light"
                               Foreground="{StaticResource ICDTitleForeground}"/>
                    <TextBlock Text="Windows Core OS 镜像设计与配置工作区"
                               FontSize="13" Foreground="{StaticResource ICDForeground}" Margin="0,8,0,0"/>
                    <TextBlock Text="创建工程、导入现有 OEMInput，或继续处理最近使用的工程。"
                               FontSize="12" Foreground="{StaticResource ICDSubtle}" Margin="0,4,0,0"/>
                </StackPanel>
                <Image Grid.Column="1" Source="/Assets/banner.png" Width="74" Height="74"
                       Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="Create" Style="{StaticResource StartSection}"/>

            <Grid Grid.Row="2" Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource StartTile}" Height="156"
                        AutomationProperties.Name="Tile-新建高级项目配置"
                        Command="{Binding NewOemInputCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource ICDAccent}" Margin="0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                           Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="NEW" FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,18,0">
                            <TextBlock Text="高级项目配置" Style="{StaticResource StartTileTitle}" FontSize="17"/>
                            <TextBlock Text="OEMInput 设计器" FontSize="12" Foreground="{StaticResource ICDAccentDark}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="扫描 FM、配置语言和 Features，生成并校验 OEMInput.xml。"
                                       Style="{StaticResource StartTileDescription}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource StartTile}" Height="156"
                        Command="{Binding OpenDeviceLayoutBuilderCommand}"
                        AutomationProperties.Name="Tile-设备布局创建">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   Foreground="{StaticResource ICDAccent}" HorizontalAlignment="Left"/>
                        <TextBlock Text="设备布局创建" Style="{StaticResource StartTileTitle}" Margin="0,13,0,0"/>
                        <TextBlock Text="编辑分区并生成 DeviceLayout FM + CAB。"
                                   Style="{StaticResource StartTileDescription}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource StartTile}" Height="156"
                        Command="{Binding OpenImageBuildCommand}"
                        AutomationProperties.Name="Tile-镜像构建">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   Foreground="{StaticResource ICDAccent}" HorizontalAlignment="Left"/>
                        <TextBlock Text="构建系统镜像" Style="{StaticResource StartTileTitle}" Margin="0,13,0,0"/>
                        <TextBlock Text="使用 OS 包和 OEMInput 输出 FFU / VHDX。"
                                   Style="{StaticResource StartTileDescription}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource StartTile}" Height="156"
                        Command="{Binding OpenUpdateAppCommand}"
                        AutomationProperties.Name="Tile-updateapp更新调度">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource ICDAccentBright}" Margin="0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                           Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="UPDATE" FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,18,0">
                            <TextBlock Text="updateapp 更新调度" Style="{StaticResource StartTileTitle}" FontSize="17"/>
                            <TextBlock Text="按 build 调度系统更新" FontSize="12" Foreground="{StaticResource ICDAccentDark}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="动态加载所选版本 updateapp 的命令集，离线镜像或在线执行 stage / commit / install 等更新操作。"
                                       Style="{StaticResource StartTileDescription}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <TextBlock Text="Recent projects" Style="{StaticResource StartSection}"
                               Visibility="{Binding HasRecentProjects, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding RecentProjects}"
                                  Visibility="{Binding HasRecentProjects, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentProjectItem}">
                                <Button Style="{StaticResource StartTile}" Width="250" Height="72"
                                        Command="{Binding DataContext.OpenRecentProjectTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource ICDAccent}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,10,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource StartTileTitle}"
                                                       FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource StartTileDescription}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="尚无最近工程。创建工程后，它会出现在这里。"
                               FontSize="12" Foreground="{StaticResource ICDSubtle}"
                               Visibility="{Binding HasRecentProjects, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Open / Tools" Style="{StaticResource StartSection}"/>
                    <Button Content="打开工程…" Style="{StaticResource StartListButton}"
                            Command="{Binding OpenOemInputCommand}" CommandParameter="open"/>
                    <Button Content="设备磁盘布局预览" Style="{StaticResource StartListButton}"
                            Command="{Binding OpenDeviceLayoutCommand}"/>
                    <Button Content="系统重构" Style="{StaticResource StartListButton}"
                            Command="{Binding OpenSystemReconstructCommand}"/>
                    <Button Content="FFU 文件浏览器" Style="{StaticResource StartListButton}"
                            Command="{Binding OpenFfuBrowserCommand}"/>
                    <Button Content="UUP 更新查询与下载" Style="{StaticResource StartListButton}"
                            Command="{Binding OpenUupCommand}"/>
                    <Button Content="SxS / CBS 工具" Style="{StaticResource StartListButton}"
                            Command="{Binding OpenSxsCommand}"/>
                    <Button Content="包依赖关系分析器" Style="{StaticResource StartListButton}"
                            Command="{Binding OpenToolDependencyCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
