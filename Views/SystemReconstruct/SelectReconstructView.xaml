<UserControl x:Class="OneCore_Image_Designer.Views.SystemReconstruct.SelectReconstructView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <!-- 包列表按 GroupKey 分组（CBS/SPKG/Driver/第三方驱动/OEMInput/FM·厂商） -->
        <CollectionViewSource x:Key="GroupedPackages" Source="{Binding FilteredPackages}"
                              IsLiveGroupingRequested="True">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupKey"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>   <!-- 三选一模型（纯增量新增） -->
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="← 返回" Style="{StaticResource ICDSecondaryButton}" DockPanel.Dock="Left" Padding="12,6"
                    Command="{Binding GoBackCommand}"/>
            <TextBlock Text="选择构建" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ICDBlue}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 镜像选择栏 -->
        <Border Grid.Row="1" Style="{StaticResource ICDCard}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <Button Content="加载镜像" Style="{StaticResource ICDButton}" DockPanel.Dock="Right" Padding="16,6" Margin="8,0,0,0"
                            Command="{Binding LoadImageCommand}"/>
                    <Button Content="浏览..." Style="{StaticResource ICDSecondaryButton}" DockPanel.Dock="Right" Padding="12,6"
                            Command="{Binding BrowseImageCommand}"/>
                    <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                             Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"/>
                </DockPanel>
                <TextBlock Text="{Binding LoadStatus}" FontSize="11" Foreground="{StaticResource ICDSubText}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主内容：左侧包列表，右侧详情 -->
        <Grid Grid.Row="2" x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition x:Name="RightColumn" Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：包列表 -->
            <Border Grid.Column="0" Style="{StaticResource ICDCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="全选" Style="{StaticResource ICDSecondaryButton}" DockPanel.Dock="Left" Padding="8,4" Margin="0,0,4,0"
                                Command="{Binding SelectAllCommand}"/>
                        <Button Content="全不选" Style="{StaticResource ICDSecondaryButton}" DockPanel.Dock="Left" Padding="8,4"
                                Command="{Binding DeselectAllCommand}"/>
                        <CheckBox IsChecked="{Binding ScanManifestChannel}" Content="注册表补扫驱动"
                                  DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11"
                                  ToolTip="WCOS 镜像可能没有 *.inf 可扫：用包 manifest 的注册表节点（DriverDatabase/Services/Class）补扫驱动包"/>
                        <Button Content="离线注册表扫描" Style="{StaticResource ICDSecondaryButton}" DockPanel.Dock="Left" Padding="8,4"
                                Command="{Binding ScanHiveCommand}"
                                ToolTip="读镜像内离线 SYSTEM hive，枚举 Services 内核驱动 / Control\Class InfPath / DriverDatabase（日志进独立窗口，结果落 CSV）"/>
                        <ComboBox ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilter}"
                                  Width="80" Height="24" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="24" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="搜索包名"/>
                    </DockPanel>

                    <!-- 包列表（按类型分组：CBS/SPKG/Driver/第三方驱动/OEMInput/FM·厂商；双击条目=预览 FM/OEMInput） -->
                    <ListBox Grid.Row="1"
                             SelectedItem="{Binding SelectedItem}"
                             MouseDoubleClick="PackageList_DoubleClick"
                             ItemsSource="{Binding Source={StaticResource GroupedPackages}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="True" Margin="0,0,0,4">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource ICDBlue}"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat=({0})}" FontSize="11" Foreground="{StaticResource ICDSubText}" Margin="6,2,0,0"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="14,2,0,0"/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Margin="0,0,8,0">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOEMInput}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding TypeDisplay}" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 可拖动分隔条 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False"
                          x:Name="ContentSplitter"/>

            <!-- 右侧：详情 + OEMInput -->
            <Border Grid.Column="2" Style="{StaticResource ICDCard}">
                <TabControl BorderThickness="0" Background="Transparent">
                    <!-- 包详情标签页 -->
                    <TabItem Header="包详情">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding SelectedPackageName}" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource ICDBlue}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding SelectedPackageInfo}" FontSize="11"
                                           Foreground="{StaticResource ICDSubText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <DockPanel Grid.Row="1" Margin="0,0,0,4">
                                    <Button Content="全部收缩" Style="{StaticResource ICDSecondaryButton}"
                                            DockPanel.Dock="Right" Padding="6,2" Margin="4,0,0,0" FontSize="10"
                                            Command="{Binding CollapseAllCommand}"/>
                                    <Button Content="全部展开" Style="{StaticResource ICDSecondaryButton}"
                                            DockPanel.Dock="Right" Padding="6,2" FontSize="10"
                                            Command="{Binding ExpandAllCommand}"/>
                                    <TextBlock Text="涉及文件 (镜像内相对路径)" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TreeView Grid.Row="2" ItemsSource="{Binding PackageFileTree}"
                                          MouseDoubleClick="FileTree_DoubleClick"
                                          FontFamily="Consolas" FontSize="11"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          VirtualizingStackPanel.IsVirtualizing="True">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SizeDisplay, StringFormat=' ({0})'}" 
                                                           FontSize="10" Foreground="#FF888888" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- OEMInput标签页 -->
                    <TabItem Header="OEMInput">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <Button Content="保存OEMInput.xml" Style="{StaticResource ICDSecondaryButton}"
                                        DockPanel.Dock="Right" Padding="8,4"
                                        Command="{Binding SaveOEMInputCommand}"
                                        IsEnabled="{Binding HasOEMInput}"/>
                                <TextBlock Text="{Binding OEMInputPartition, StringFormat='来源分区: {0}'}"
                                           FontSize="11" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBox Grid.Row="1" Text="{Binding OEMInputContent}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     Background="#FFF8F8F8"
                                     BorderBrush="#FFDDDDDD" BorderThickness="1"/>

                            <TextBlock Grid.Row="2" Text="{Binding HasOEMInput, StringFormat='状态: {0}'}"
                                       FontSize="10" Foreground="{StaticResource ICDSubText}" Margin="0,4,0,0"
                                       Visibility="{Binding HasOEMInput, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 底部构建栏 -->
        <Border Grid.Row="3" Background="#FFF0F8FF" Padding="12,8" CornerRadius="4" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="外部驱动打包" Style="{StaticResource ICDSecondaryButton}" Padding="12,6" Margin="0,0,12,0"
                            Command="{Binding ExtractDriversFromFolderCommand}"
                            ToolTip="扫描外部目录的 INF（每个含 INF 的子目录成一个包），生成 wm.xml 源包，可选调 PkgGen 直接出 cab"/>
                    <Button Content="组件提取" FontSize="13" Padding="16,8" Margin="0,0,12,0"
                            Command="{Binding ExtractComponentsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ICDSecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExtracting}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Content" Value="提取中..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="开始构建选中项" FontSize="14" FontWeight="Bold" Padding="24,10"
                            Command="{Binding StartBuildCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ICDButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBuilding}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Content" Value="构建中..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding BuildStatus}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ICDBlue}"/>
                    <DockPanel Margin="0,4,0,0">
                        <Button Content="浏览..." Style="{StaticResource ICDSecondaryButton}" DockPanel.Dock="Right" Padding="8,2"
                                Command="{Binding BrowseOutputCommand}"/>
                        <TextBlock Text="输出: " FontSize="11" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                 Height="24" VerticalContentAlignment="Center" FontSize="11" Margin="0,0,8,0"/>
                    </DockPanel>
                    <!-- 组件提取选项 -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox Content="按组件分组" IsChecked="{Binding ExtractGroupByComponent}"
                                  FontSize="11" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox Content="包含注册表(.reg)" IsChecked="{Binding ExtractIncludeRegistry}"
                                  FontSize="11" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ExtractStatus}" FontSize="11" Foreground="{StaticResource ICDBlue}"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding Progress}" Height="6" Margin="0,4,0,0" Minimum="0" Maximum="100"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════ 选择重构：三选一（纯增量新增）═══════════ -->
        <Expander Grid.Row="4" Margin="0,12,0,0" IsExpanded="True"
                  Header="先定三件事 —— 输入形态 · 目标动作 · 执行方式">
            <StackPanel Margin="6,8,6,6">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}"
                           Text="页面上原来的许多开关，真正需要你决定的只有下面三件。其余选项要么能由这三项推导出来，要么属于高级参数，按需展开即可。"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="① 输入形态" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SourceShapes}" SelectedItem="{Binding SourceShape}" Height="26" Margin="0,0,16,0"/>

                    <TextBlock Grid.Column="2" Text="② 目标动作" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding TargetActions}" SelectedItem="{Binding TargetAction}" Height="26" Margin="0,0,16,0"/>

                    <TextBlock Grid.Column="4" Text="③ 执行方式" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="5" ItemsSource="{Binding ExecutionModes}" SelectedItem="{Binding ExecutionMode}" Height="26"/>
                </Grid>

                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
                        Background="{StaticResource CardBrush}">
                    <TextBlock Text="{Binding CapabilitySummary}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                </Border>

                <Button Content="按上面三项执行" Command="{Binding DispatchCommand}"
                        Style="{StaticResource ICDButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                <TextBox Text="{Binding DispatchResult}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12" Height="180" Margin="0,10,0,0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Visibility="{Binding HasDispatchResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Expander>

    </Grid>
</UserControl>
