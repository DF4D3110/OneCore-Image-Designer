<UserControl x:Class="OneCore_Image_Designer.Views.SystemReconstruct.FullReconstructView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="← 返回" Style="{StaticResource ICDSecondaryButton}" DockPanel.Dock="Left" Padding="12,6"
                    Command="{Binding GoBackCommand}"/>
            <TextBlock Text="完全构建" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ICDBlue}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 主内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 镜像文件 -->
                <Border Style="{StaticResource ICDCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="镜像文件" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="浏览..." Style="{StaticResource ICDButton}" DockPanel.Dock="Right" Padding="12,6"
                                    Command="{Binding BrowseImageCommand}"/>
                            <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock FontSize="11" FontWeight="Bold" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImageValid}" Value="True">
                                            <Setter Property="Text" Value="✓ 文件有效"/>
                                            <Setter Property="Foreground" Value="#FF2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsImageValid}" Value="False">
                                            <Setter Property="Text" Value="✗ 文件不存在"/>
                                            <Setter Property="Foreground" Value="#FFC62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{StaticResource ICDSubText}" TextWrapping="Wrap" Margin="0,4,0,0">
                            支持格式: FFU, VHDX, VHD, WIM
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 输出文件夹 -->
                <Border Style="{StaticResource ICDCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="输出文件夹" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button Content="浏览..." Style="{StaticResource ICDButton}" DockPanel.Dock="Right" Padding="12,6"
                                    Command="{Binding BrowseOutputCommand}"/>
                            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource ICDSubText}" TextWrapping="Wrap" Margin="0,8,0,0">
                            输出内容: CBS包、SPKG包、Driver包、FM文件
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部构建按钮 -->
        <Border Grid.Row="2" Background="#FFF0F8FF" Padding="12,8" CornerRadius="4" Margin="0,12,0,0">
            <DockPanel>
                <Button Content="开始构建" FontSize="14" FontWeight="Bold" Padding="32,10"
                        DockPanel.Dock="Right"
                        Command="{Binding StartBuildCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ICDButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBuilding}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content" Value="构建中..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding BuildStatus}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ICDBlue}"/>
                    <ProgressBar Value="{Binding Progress}" Height="8" Margin="0,4,0,0" Minimum="0" Maximum="100"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
