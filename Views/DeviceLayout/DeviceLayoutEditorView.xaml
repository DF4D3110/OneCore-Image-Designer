<UserControl x:Class="OneCore_Image_Designer.Views.DeviceLayout.DeviceLayoutEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OneCore_Image_Designer.Converters"
             xmlns:local="clr-namespace:OneCore_Image_Designer.Views.DeviceLayout"
             xmlns:vmDL="clr-namespace:OneCore_Image_Designer.ViewModels.DeviceLayout"
             Background="{StaticResource AppBackground}"
             FontSize="13">
    <UserControl.Resources>
        <conv:PartitionColorConverter x:Key="PartColor"/>
        <vmDL:StepStateToBrushConverter x:Key="StepBrush"/>
        <vmDL:StepStateToTextConverter x:Key="StepGlyph"/>
        <vmDL:RatioToWidthConverter x:Key="RatioW"/>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{StaticResource ICDSubtle}"/>
        </Style>
        <Style x:Key="Inp" TargetType="Control">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,14,8"/>
        </Style>
        <Style x:Key="StepChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource ICDSurface}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 步进条 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Style="{StaticResource StepChip}" Background="{Binding State1, Converter={StaticResource StepBrush}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding State1, Converter={StaticResource StepGlyph}}" FontWeight="Bold" Width="18"/>
                    <TextBlock Text="1 包信息"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StepChip}" Background="{Binding State2, Converter={StaticResource StepBrush}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding State2, Converter={StaticResource StepGlyph}}" FontWeight="Bold" Width="18"/>
                    <TextBlock Text="2 编辑分区"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StepChip}" Background="{Binding State3, Converter={StaticResource StepBrush}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding State3, Converter={StaticResource StepGlyph}}" FontWeight="Bold" Width="18"/>
                    <TextBlock Text="3 验证"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StepChip}" Background="{Binding State4, Converter={StaticResource StepBrush}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding State4, Converter={StaticResource StepGlyph}}" FontWeight="Bold" Width="18"/>
                    <TextBlock Text="4 打包"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="2,0,0,12">
            <TextBlock Text="DeviceLayout 设计器" FontSize="19" FontWeight="Light"
                       Foreground="{StaticResource ICDTitleForeground}"/>
            <TextBlock Text="{Binding StepInfoText}" FontSize="12" Margin="0,4,0,0"
                       Foreground="{StaticResource ICDSubtle}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- 步1：包信息 -->
            <GroupBox Header="包信息与起点" Padding="14" Visibility="{Binding ShowStep1}">
                <StackPanel>
                    <TextBlock Text="从一个官方模板开始（推荐）；模板标注了适用设备类型与 buildtag。也可选形状从空白开始，或从 XML/CAB 导入起点。"
                               Foreground="{StaticResource ICDSubtle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <TextBlock Text="模板" Style="{StaticResource Lbl}"/>
                            <ComboBox Width="380" Style="{StaticResource Inp}"
                                      ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                                      DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <TextBlock Text="形状" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="CmbShape" Width="230" Style="{StaticResource Inp}" SelectedIndex="0"
                                      SelectionChanged="Shape_Changed"
                                      ToolTip="决定 DeviceLayout 结构；从模板载入会自动设为模板原形状。第二步里加磁盘/升级存储池会自动改变形状">
                                <ComboBoxItem Content="单盘平铺 (flat)"/>
                                <ComboBoxItem Content="多 LUN (Stores)"/>
                                <ComboBoxItem Content="存储池 (DeviceLayout)"/>
                                <ComboBoxItem Content="存储池·拆分盘 (MSDeviceLayout)"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Content="从 XML / CAB 导入起点…" Click="Import_Click" Padding="12,5" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                        <Button Content="从空白开始" Click="Blank_Click" Padding="12,5" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="布局元数据（打包时的包名 / SOC / 版本 / 架构 / 扇区）" FontWeight="Bold" Margin="0,10,0,6"/>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <TextBlock Text="时代" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="CmbEra" Width="190" Style="{StaticResource Inp}" SelectedIndex="{Binding Era}"
                                      SelectionChanged="Era_Changed">
                                <ComboBoxItem Content="现代 (FactoryOS)"/>
                                <ComboBoxItem Content="早期 (Phone WPAK)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <TextBlock Text="包 ID" Style="{StaticResource Lbl}"/>
                            <TextBox Text="{Binding PackageId, UpdateSourceTrigger=PropertyChanged}" Width="320" Style="{StaticResource Inp}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <TextBlock Text="SOC" Style="{StaticResource Lbl}"/>
                            <TextBox Text="{Binding Soc, UpdateSourceTrigger=PropertyChanged}" Width="150" Style="{StaticResource Inp}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <TextBlock Text="版本" Style="{StaticResource Lbl}"/>
                            <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Width="140" Style="{StaticResource Inp}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <TextBlock Text="架构" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="CmbArch2" Width="100" Style="{StaticResource Inp}" SelectedIndex="0"
                                      SelectionChanged="Arch_Changed">
                                <ComboBoxItem Content="arm64"/><ComboBoxItem Content="arm"/><ComboBoxItem Content="x86"/><ComboBoxItem Content="amd64"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <TextBlock Text="扇区" Style="{StaticResource Lbl}"/>
                            <ComboBox Width="90" Style="{StaticResource Inp}" SelectedIndex="{Binding SectorIndex}">
                                <ComboBoxItem Content="512"/><ComboBoxItem Content="4096"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding LastLog}" Foreground="{StaticResource ICDSubtle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- 步2：磁盘视图（每条磁盘独立横向滚动，右侧不再裁切）+ 磁盘级操作 -->
            <Grid Visibility="{Binding ShowStep2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Padding="8"
                          Header="磁盘 / LUN / 存储池视图（点色块=选分区；点条带空白=选磁盘；蓝底=池内，灰底=池外/LUN）">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonUp="DiskBand_Click" Tag="{Binding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="176"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderThickness="3,0,0,0" Padding="6,2,8,2"
                                                BorderBrush="{Binding IsSelected, Converter={StaticResource StepBrush}, ConverterParameter=sel}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold"
                                                           Foreground="{StaticResource ICDTitleForeground}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayTitle}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PartsCount}" Foreground="{StaticResource ICDSubtle}" FontSize="11"/>
                                                    <TextBlock Text="{Binding DiskSizeText}" Margin="8,0,0,0"
                                                               Foreground="{StaticResource ICDSubtle}" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="3" BorderThickness="1"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                Background="{Binding InPool, Converter={StaticResource StepBrush}, ConverterParameter=band}">
                                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Padding="0">
                                                <ItemsControl ItemsSource="{Binding Tiles}" MinWidth="{Binding BandMinWidth}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><local:ProportionalBarPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border MouseLeftButtonUp="Tile_Click" Cursor="Hand" Tag="{Binding}"
                                                                    local:ProportionalBarPanel.Ratio="{Binding Ratio}"
                                                                    BorderThickness="2" CornerRadius="2"
                                                                    BorderBrush="{Binding IsSelected, Converter={StaticResource StepBrush}, ConverterParameter=sel}"
                                                                    Background="{Binding Name, Converter={StaticResource PartColor}}"
                                                                    Height="46" Margin="1" ToolTip="{Binding TipText}">
                                                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                                    <TextBlock Text="{Binding SizeBar}" Foreground="White" FontSize="10"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="＋ 添加磁盘" Click="AddDiskLevel_Click" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="平铺时自动升级为多盘结构（StoreType 在下方磁盘属性里填）"/>
                    <Button Content="＋ 池内成员盘" Click="AddPoolDiskLevel_Click" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="存储池形状下加一块成员虚拟盘（非池形状会先自动升级为存储池）"/>
                    <Button Content="升级为存储池" Click="UpgradePool_Click" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="－ 删除选中磁盘" Click="RemoveDisk_Click" Padding="10,4" Margin="0,0,8,0"
                            IsEnabled="{Binding HasDisk}"/>
                    <Separator Width="14" Background="Transparent"/>
                    <Button Content="＋ 在当前盘加分区" Click="AddPart_Click" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="－ 删除选中分区" Click="DelPart_Click" Padding="10,4" Margin="0,0,6,0"
                            IsEnabled="{Binding HasSelection}"/>
                    <Button Content="把选中分区移到当前盘" Click="MoveSelectedHere_Click" Padding="10,4" Margin="0,0,8,0"
                            IsEnabled="{Binding CanMove}"/>
                    <Button Content="另存为自定义模板…" Click="SaveTemplate_Click" Padding="10,4" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DiskCountText}" VerticalAlignment="Center" Foreground="{StaticResource ICDSubtle}"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="选中磁盘属性（StoreType 必填；改完点「应用」）" Padding="8" Margin="0,8,8,0"
                              Visibility="{Binding ShowDiskPanel}">
                        <WrapPanel DataContext="{Binding SelectedDiskNode}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="StoreType" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding StoreType, UpdateSourceTrigger=PropertyChanged}" Width="150" Style="{StaticResource Inp}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="盘 Id" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="260" Style="{StaticResource Inp}"
                                         ToolTip="官方样本多用固定 GUID；留空=打包时不写"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="DevicePath" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding DevicePath, UpdateSourceTrigger=PropertyChanged}" Width="230" Style="{StaticResource Inp}"
                                         ToolTip="如 VenHw(...)；留空=不写"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="容量" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding SizeValue, UpdateSourceTrigger=PropertyChanged}" Width="120" Style="{StaticResource Inp}"
                                         ToolTip="MS 字节制布局填字节，其余填扇区数；0=未指定"/>
                            </StackPanel>
                            <CheckBox Content="仅分配已定义GPT项" IsChecked="{Binding OnlyDefinedGptEntries}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <Button Content="应用" Click="CommitDisk_Click" Padding="12,4" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="选中分区属性（改完点「应用」刷新色块）" Padding="8" Margin="0,8,0,0"
                              Visibility="{Binding ShowPropPanel}">
                        <WrapPanel DataContext="{Binding SelectedPartition}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="名称" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="130" Style="{StaticResource Inp}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="类型 GUID" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="270" Style="{StaticResource Inp}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="文件系统" Style="{StaticResource Lbl}"/>
                                <ComboBox Width="90" Style="{StaticResource Inp}" Text="{Binding FileSystem, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="NTFS"/><ComboBoxItem Content="FAT"/><ComboBoxItem Content="RAW"/><ComboBoxItem Content="exFAT"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="总扇区数" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding TotalSectors, UpdateSourceTrigger=PropertyChanged}" Width="110" Style="{StaticResource Inp}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="最小空闲" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding MinFreeSectors, UpdateSourceTrigger=PropertyChanged}" Width="110" Style="{StaticResource Inp}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="字节对齐" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding ByteAlignment, UpdateSourceTrigger=PropertyChanged}" Width="110" Style="{StaticResource Inp}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock Text="簇大小" Style="{StaticResource Lbl}"/>
                                <TextBox Text="{Binding ClusterSize, UpdateSourceTrigger=PropertyChanged}" Width="90" Style="{StaticResource Inp}"/>
                            </StackPanel>
                            <CheckBox Content="用满剩余" IsChecked="{Binding UseAllSpace}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <CheckBox Content="可引导" IsChecked="{Binding Bootable}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <CheckBox Content="需刷写" IsChecked="{Binding RequiredToFlash}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <Button Content="应用刷新" Click="ApplyProp_Click" Padding="12,4" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </GroupBox>
                </Grid>
            </Grid>

            <!-- 步3：验证 -->
            <GroupBox Header="官方规则验证（硬闸门：不通过不能进入打包）" Padding="14" Visibility="{Binding ShowStep3}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="校验规则" Style="{StaticResource Lbl}"/>
                        <ComboBox Width="440" Style="{StaticResource Inp}" ItemsSource="{Binding RuleItems}" SelectedItem="{Binding RuleChoice}"/>
                        <Button x:Name="BtnValidate" Content="开始验证" Click="Validate_Click" Padding="14,4" FontWeight="Bold"
                                Background="{StaticResource ICDBlue}" Foreground="White" BorderThickness="0" Margin="0,0,10,8"/>
                        <TextBlock Text="{Binding ValidationVerdict}" VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="{StaticResource ICDTitleForeground}"/>
                    </StackPanel>
                    <Border Background="{StaticResource ICDLightBlue}" Padding="10,7" Margin="0,0,0,8">
                        <TextBlock Text="{Binding PreflightSummary}" Foreground="{StaticResource ICDDarkBlue}"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                    <ListBox ItemsSource="{Binding ValidationLines}" FontFamily="Consolas" FontSize="12"
                             BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                </DockPanel>
            </GroupBox>

            <!-- 步4：打包 -->
            <GroupBox Header="生成 FM + CAB（已验证通过）" Padding="14" Visibility="{Binding ShowStep4}">
                <StackPanel>
                    <TextBlock Text="布局已通过验证，可打包。签名需要测试证书 .pfx（可选）。" Foreground="{StaticResource ICDSubtle}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseOut_Click" Padding="10,4" Margin="8,0,0,0"/>
                        <TextBlock Text="输出目录" Style="{StaticResource Lbl}" Width="64"/>
                        <TextBox x:Name="TxtOutBox" Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <CheckBox Content="生成后签名（需 .pfx）" IsChecked="{Binding WantSign}" Margin="0,0,0,10"/>
                    <Button x:Name="BtnBuild" Content="生成 FM + CAB" Click="Build_Click" Padding="16,6" FontWeight="Bold"
                            HorizontalAlignment="Left" Background="{StaticResource ICDBlue}" Foreground="White" BorderThickness="0"/>
                    <TextBlock Text="{Binding LastLog}" Foreground="{StaticResource ICDSubtle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,10,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="下一步 ›" Click="Next_Click" Padding="18,6" Margin="8,0,0,0"
                    IsEnabled="{Binding CanNext}" Background="{StaticResource ICDBlue}" Foreground="White" BorderThickness="0"/>
            <Button DockPanel.Dock="Right" Content="‹ 上一步" Click="Prev_Click" Padding="14,6" IsEnabled="{Binding CanPrev}"/>
        </DockPanel>
        </Border>
    </Grid>
</UserControl>
