<UserControl x:Class="OneCore_Image_Designer.Views.FFUBrowser.HexViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍 十六进制查看器" Foreground="#CCCCCC" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="InfoText" Foreground="#888888" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnStructure" Content="🏗️ 结构" Click="BtnStructure_Click"
                            Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555" Padding="8,2" Margin="0,0,8,0"
                            FontSize="11" Cursor="Hand"/>
                    <Button x:Name="BtnStrings" Content="📝 字符串" Click="BtnStrings_Click"
                            Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555" Padding="8,2" Margin="0,0,8,0"
                            FontSize="11" Cursor="Hand"/>
                    <Button x:Name="BtnGoto" Content="🎯 跳转" Click="BtnGoto_Click"
                            Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555" Padding="8,2"
                            FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 格式信息栏 -->
        <Border x:Name="FormatInfoBar" Grid.Row="1" Background="#1E3A5F" Padding="8,4" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋 格式: " Foreground="#4EC9B0" FontWeight="Bold" FontSize="11"/>
                <TextBlock x:Name="FormatText" Foreground="#DCDCAA" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- 主内容区：十六进制 + 字符串面板 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 十六进制视图 -->
            <Grid Grid.Column="0">
                <!-- 列标题 -->
                <Border VerticalAlignment="Top" Background="#252526" Padding="8,2" Panel.ZIndex="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="偏移" Foreground="#569CD6" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="00 01 02 03 04 05 06 07  08 09 0A 0B 0C 0D 0E 0F" Foreground="#569CD6" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="ASCII" Foreground="#569CD6" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- 十六进制数据列表（虚拟化） -->
                <ListBox x:Name="HexListBox"
                         Margin="0,24,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🔍 数据解释 (当前位置)" Click="DataInterpret_Click"/>
                            <MenuItem Header="📋 复制偏移" Click="CopyOffset_Click"/>
                            <MenuItem Header="📋 复制十六进制" Click="CopyHex_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2A2D2E"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Offset}" Foreground="#858585" FontFamily="Consolas" FontSize="12" Padding="8,2"/>
                                <TextBlock Grid.Column="1" Text="{Binding Hex}" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="12" Padding="0,2"/>
                                <TextBlock Grid.Column="2" Text="{Binding Ascii}" Foreground="#CE9178" FontFamily="Consolas" FontSize="12" Padding="0,2"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="3" Background="#3E3E42" HorizontalAlignment="Stretch"/>

            <!-- 字符串列表面板 -->
            <Border Grid.Column="2" Background="#252526" x:Name="StringsPanel" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📝 字符串列表" Foreground="#4EC9B0" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="StringsCount" Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!-- 搜索框 -->
                    <Border DockPanel.Dock="Top" Background="#252526" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StringsSearchBox"
                                     Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#555"
                                     FontFamily="Consolas" FontSize="11" Padding="4,2"
                                     TextChanged="StringsSearchBox_TextChanged"
                                     ToolTip="搜索字符串（支持模糊匹配）"/>
                            <Button Grid.Column="1" Content="✕" Width="24" Height="24" Margin="4,0,0,0"
                                    Background="#3E3E42" Foreground="#888" BorderBrush="#555"
                                    Click="StringsSearchClear_Click" ToolTip="清除搜索"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="StringsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             MouseDoubleClick="StringsListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2A2D2E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" Foreground="#DCDCAA" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding OffsetDisplay}" Foreground="#6A9955" FontFamily="Consolas" FontSize="9"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 结构信息面板 -->
            <Border Grid.Column="2" Background="#252526" x:Name="StructurePanel" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,4">
                        <TextBlock Text="🏗️ 固件结构" Foreground="#DCDCAA" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StructureContent" Margin="8,4"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#007ACC" Padding="8,2">
            <TextBlock x:Name="StatusText" Foreground="White" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
