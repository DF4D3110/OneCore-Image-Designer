<UserControl x:Class="OneCore_Image_Designer.Views.FFUBrowser.FFUBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OneCore_Image_Designer.Views.FFUBrowser"
             xmlns:models="clr-namespace:OneCore_Image_Designer.Models.FFUBrowser"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <ContextMenu x:Key="FileContextMenu">
            <MenuItem Header="提取选中项" Command="{Binding DataContext.ExtractSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <MenuItem Header="提取当前目录所有文件" Command="{Binding DataContext.ExtractAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Separator/>
            <MenuItem Header="刷新" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </ContextMenu>

        <ContextMenu x:Key="TreeContextMenu">
            <MenuItem x:Name="ExtractPartitionMenuItem" Header="提取此分区为bin文件" Command="{Binding DataContext.ExtractPartitionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <MenuItem x:Name="ParseFirmwareMenuItem" Header="🔍 解析固件结构 (UEFI/ELF)" Click="ParseFirmware_Click"/>
            <MenuItem Header="导出为C语言数组" Command="{Binding DataContext.ExportAsCArrayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <MenuItem Header="导出为Intel HEX格式" Command="{Binding DataContext.ExportAsIntelHexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <MenuItem Header="计算校验和 (MD5/SHA)" Command="{Binding DataContext.ShowChecksumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Separator/>
            <MenuItem Header="批量提取所有固件分区" Command="{Binding DataContext.ExtractAllFirmwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Separator/>
            <MenuItem Header="提取此文件夹所有文件" Command="{Binding DataContext.ExtractAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Separator/>
            <MenuItem Header="刷新" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="12" AllowDrop="True" DragEnter="FFUBrowserView_DragEnter" Drop="FFUBrowserView_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="← 返回" Style="{StaticResource ICDSecondaryButton}"
                    DockPanel.Dock="Left" Padding="12,6" Margin="0,0,12,0"
                    Command="{Binding NavigateToStartCommand}"/>
            <TextBlock Text="FFU 文件浏览器" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource ICDBlue}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="{StaticResource ICDCardBackground}"
                BorderBrush="{StaticResource ICDBorder}" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,12">
            <DockPanel>
                <Button Content="📂 浏览" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding BrowseImageCommand}"/>
                <Button Content="🔄 加载" Style="{StaticResource ICDButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding LoadImageCommand}" IsEnabled="{Binding IsNotLoading}"/>
                <Separator DockPanel.Dock="Left" Margin="8,0"/>
                <Button Content="📤 提取选中" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding ExtractSelectedCommand}"/>
                <Button Content="📦 提取全部" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding ExtractAllCommand}"/>
                <Separator DockPanel.Dock="Left" Margin="8,0"/>
                <Button Content="💾 提取分区bin" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding ExtractPartitionCommand}"
                        IsEnabled="{Binding IsFirmwarePartitionSelected}"
                        ToolTip="将当前选中的固件分区提取为原始bin文件（仅固件分区可用）"/>
                <Button Content="🔧 提取所有固件" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding ExtractAllFirmwareCommand}" ToolTip="批量提取所有固件分区为bin文件"/>
                <Button Content="📋 校验和" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding ShowChecksumCommand}"
                        IsEnabled="{Binding IsPartitionSelected}"
                        ToolTip="计算当前分区的MD5/SHA1/SHA256校验和"/>
                <Button Content="📊 导出分区表" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding ExportPartitionTableCommand}"
                        ToolTip="导出完整分区表为CSV/JSON/文本格式"/>
                <Button Content="↻ 刷新" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"/>
                <Button x:Name="RecentFilesButton" Content="🕐 最近" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Click="RecentFilesButton_Click"
                        ToolTip="最近打开的文件">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RecentFilesMenu" ItemsSource="{Binding RecentFiles}">
                            <ContextMenu.ItemTemplate>
                                <DataTemplate>
                                    <MenuItem Header="{Binding}"
                                              Command="{Binding DataContext.LoadRecentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              ToolTip="{Binding}"/>
                                </DataTemplate>
                            </ContextMenu.ItemTemplate>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Separator DockPanel.Dock="Left" Margin="8,0"/>
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" Width="180" VerticalContentAlignment="Center" Margin="0,0,8,0"
                         ToolTip="搜索文件名，支持 * 和 ? 通配符">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="🔍 搜索" Style="{StaticResource ICDButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding SearchCommand}" ToolTip="搜索文件（支持通配符）"/>
                <CheckBox Content="全部分区" IsChecked="{Binding SearchAllPartitions}"
                          VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                          ToolTip="勾选后搜索所有分区，否则只搜索当前分区"/>
                <Button Content="✕ 清除" Style="{StaticResource ICDSecondaryButton}"
                        DockPanel.Dock="Left" Padding="8,5" Margin="0,0,8,0"
                        Command="{Binding ClearSearchCommand}" ToolTip="清除搜索结果"/>

                <Separator DockPanel.Dock="Left" Margin="8,0"/>
                <Button Content="📄 生成报告" Style="{StaticResource ICDButton}"
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding GenerateReportCommand}" ToolTip="生成镜像信息报告（HTML/文本）"/>

                <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" VerticalContentAlignment="Center" Margin="12,0,0,0"
                         ToolTip="镜像文件路径"/>
            </DockPanel>
        </Border>

        <!-- 地址栏 -->
        <Border Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"/>
        <DockPanel Grid.Row="1" Margin="0,52,0,0" Panel.ZIndex="1">
            <TextBlock Text="📁 路径: " FontSize="11" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentPath}" FontSize="11" Foreground="{StaticResource ICDText}" VerticalAlignment="Center"
                       FontFamily="Consolas"/>
        </DockPanel>

        <!-- 主内容区：左侧树 + 右侧文件列表 -->
        <Grid Grid.Row="2" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：磁盘/文件夹树 -->
            <Border Grid.Column="0" Style="{StaticResource ICDCard}">
                <DockPanel>
                    <TextBlock Text="📂 目录树" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource ICDBlue}" Margin="8,8,8,4"
                               DockPanel.Dock="Top"/>
                    <TreeView x:Name="FolderTree"
                              ItemsSource="{Binding DiskTree}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              ContextMenuOpening="FolderTree_ContextMenuOpening"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="ContextMenu" Value="{StaticResource TreeContextMenu}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}" DataType="{x:Type models:FFUBrowserNode}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock Text="{Binding SizeDisplay, StringFormat=' ({0})'}"
                                               FontSize="9" Foreground="#FF888888" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False"/>

            <!-- 右侧：文件列表 / UEFI变量列表 -->
            <Border Grid.Column="2" Style="{StaticResource ICDCard}">
                <DockPanel>
                    <!-- FFU文件头信息面板 -->
                    <Border DockPanel.Dock="Top" Background="#FFE8F5E9" Padding="8,6" Margin="8,8,8,4"
                            Visibility="{Binding ShowFfuHeader, Converter={StaticResource BooleanToVisibilityConverter}}"
                            CornerRadius="4">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📦 FFU镜像信息" FontSize="12" FontWeight="Bold"
                                           Foreground="#FF2E7D32" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding FfuHeader.StoreCount, StringFormat='{}{0} 个存储'}"
                                           FontSize="10" Foreground="#FF558B2F" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="签名:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FfuHeader.Signature}" FontSize="10" Foreground="#333" FontFamily="Consolas"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="头大小:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FfuHeader.HeaderSize, StringFormat='{}{0} 字节'}" FontSize="10" Foreground="#333"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="块大小:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FfuHeader.ChunkSize, StringFormat='{}{0} KB'}" FontSize="10" Foreground="#333"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="清单长度:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FfuHeader.ManifestLength, StringFormat='{}{0:N0} 字节'}" FontSize="10" Foreground="#333"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 节点详细信息面板 -->
                    <Border DockPanel.Dock="Top" Padding="8,6" Margin="8,8,8,4"
                            Visibility="{Binding ShowPartitionInfo, Converter={StaticResource BooleanToVisibilityConverter}}"
                            CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFF0F8FF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentNode.IsDisk}" Value="True">
                                        <Setter Property="Background" Value="#FFF5F5DC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CurrentNode.Name}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource ICDBlue}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding CurrentNode.SizeDisplay}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNode.IsDisk}" Value="True">
                                                    <Setter Property="Text" Value="{Binding CurrentNode.DiskTotalSize, StringFormat='{}{0:N0} 字节'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- 磁盘信息（仅磁盘节点显示） -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentNode.IsDisk}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="磁盘索引:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentNode.DiskIndex}" FontSize="10" Foreground="#333"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="分区数量:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentNode.Children.Count}" FontSize="10" Foreground="#333"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="总大小:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentNode.DiskTotalSize, StringFormat='{}{0:N0} 字节'}" FontSize="10" Foreground="#333"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="磁盘类型:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentNode.DiskTypeDescription}" FontSize="10" Foreground="#333"/>
                                </Grid>

                                <!-- 磁盘布局可视化 -->
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding ShowDiskLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="📊 分区布局" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ICDBlue}" Margin="0,0,0,4"/>
                                    <!-- 横向条形图 -->
                                    <Grid Height="24" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <!-- 动态生成列，用ItemsControl替代 -->
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl ItemsSource="{Binding DiskLayoutItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding BarWidth}"
                                                            Height="24" Background="{Binding Color}"
                                                            BorderBrush="White" BorderThickness="0.5"
                                                            ToolTip="{Binding Name, StringFormat='{}{0}: {1} ({2}%)'}">
                                                        <TextBlock Text="{Binding Name}" FontSize="9" Foreground="White"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Margin="2,0"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <!-- 图例 -->
                                    <WrapPanel Margin="0,2,0,0">
                                        <ItemsControl ItemsSource="{Binding DiskLayoutItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,2">
                                                        <Rectangle Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                        <TextBlock FontSize="9" Foreground="#555" VerticalAlignment="Center">
                                                            <Run Text="{Binding Name}"/>
                                                            <Run Text=" (" />
                                                            <Run Text="{Binding Percentage, StringFormat='{}{0:F1}%'}"/>
                                                            <Run Text=")" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 分区信息（仅分区节点显示） -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentNode.IsPartition}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="类型:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                <TextBlock Grid.Column="1" FontSize="10" Foreground="#333">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding CurrentNode.PartitionTypeDescription}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNode.IsVirtualPartition}" Value="True">
                                                    <Setter Property="Text" Value="虚拟分区 (UpdateOS WIM内容)"/>
                                                    <Setter Property="Foreground" Value="#B8860B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="类型GUID:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentNode.PartitionTypeGuid}" FontSize="10" Foreground="#666" FontFamily="Consolas">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNode.IsVirtualPartition}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="分区ID:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentNode.PartitionId}" FontSize="10" Foreground="#666" FontFamily="Consolas">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNode.IsVirtualPartition}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="大小:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentNode.Size, StringFormat='{}{0:N0} 字节'}" FontSize="10" Foreground="#666"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="文件系统:" FontSize="10" Foreground="{StaticResource ICDSubText}"/>
                                <TextBlock Grid.Column="1" FontSize="10" Foreground="#666">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="raw (无文件系统)"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNode.HasFileSystem}" Value="True">
                                                    <Setter Property="Text" Value="已识别文件系统"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentNode.IsVirtualPartition}" Value="True">
                                                    <Setter Property="Text" Value="WIM镜像内容 (UpdateOS更新包)"/>
                                                    <Setter Property="Foreground" Value="#B8860B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <!-- 分区类型详细说明 -->
                            <Border Margin="0,6,0,0" Background="#FFFFFF" Padding="6,4" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="💡 详细说明" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ICDBlue}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding CurrentNode.PartitionTypeDetail}" FontSize="10" Foreground="#555" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 文件列表视图 -->
                    <Grid DockPanel.Dock="Top" Margin="8,8,8,4" Visibility="{Binding ShowFileList, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📄 文件列表" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource ICDBlue}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding FileList.Count, StringFormat='{}{0} 项'}"
                                   FontSize="10" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center"/>
                    </Grid>

                    <ListView x:Name="FileListView"
                              ItemsSource="{Binding FileList}"
                              SelectionMode="Extended"
                              SelectionChanged="FileListView_SelectionChanged"
                              MouseDoubleClick="FileListView_MouseDoubleClick"
                              MouseMove="FileListView_MouseMove"
                              ContextMenu="{StaticResource FileContextMenu}"
                              Visibility="{Binding ShowFileList, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="250">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding TypeDisplay}"/>
                                <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding ModifiedTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- 搜索结果视图 -->
                    <Grid DockPanel.Dock="Top" Margin="8,8,8,4" Visibility="{Binding ShowSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 搜索结果" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource ICDBlue}" VerticalAlignment="Center"/>
                            <TextBlock Text=" (双击打开所在目录)" FontSize="10" Foreground="#FF888888" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SearchResults.Count, StringFormat='{}{0} 个文件'}"
                                   FontSize="10" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center"/>
                    </Grid>

                    <ListView x:Name="SearchResultListView"
                              ItemsSource="{Binding SearchResults}"
                              SelectionMode="Extended"
                              MouseDoubleClick="SearchResultListView_MouseDoubleClick"
                              ContextMenu="{StaticResource FileContextMenu}"
                              Visibility="{Binding ShowSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="分区" Width="100" DisplayMemberBinding="{Binding PartitionName}"/>
                                <GridViewColumn Header="名称" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="路径" Width="200" DisplayMemberBinding="{Binding FullPath}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- UEFI变量视图 -->
                    <Grid DockPanel.Dock="Top" Margin="8,8,8,4" Visibility="{Binding ShowUefiVariables, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔐 UEFI 变量" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource ICDBlue}" VerticalAlignment="Center"/>
                            <TextBlock Text=" (只读)" FontSize="10" Foreground="#FF888888" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding UefiVariables.Count, StringFormat='{}{0} 个变量'}"
                                   FontSize="10" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center"/>
                    </Grid>

                    <ListView x:Name="UefiVariableListView"
                              ItemsSource="{Binding UefiVariables}"
                              SelectionMode="Single"
                              Visibility="{Binding ShowUefiVariables, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="变量名" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Vendor GUID" Width="220" DisplayMemberBinding="{Binding VendorGuid}"/>
                                <GridViewColumn Header="属性" Width="100" DisplayMemberBinding="{Binding AttributesDisplay}"/>
                                <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding DataSize}"/>
                                <GridViewColumn Header="值预览" Width="250" DisplayMemberBinding="{Binding DataStringPreview}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- 十六进制查看器（raw分区） -->
                    <local:HexViewerControl x:Name="HexViewer"
                                             Visibility="{Binding ShowHexViewer, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- 文件预览面板 -->
                    <Border DockPanel.Dock="Top" Margin="8,4,8,8" Padding="8"
                            Background="#FFFAFAFA" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding ShowPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <!-- 预览标题栏 -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PreviewTitle}" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource ICDBlue}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="✕" Width="24" Height="20" Padding="0"
                                        FontSize="10" Cursor="Hand"
                                        Click="ClosePreviewButton_Click"
                                        ToolTip="关闭预览"/>
                            </Grid>

                            <!-- 文本预览 -->
                            <TextBox Text="{Binding PreviewText}" IsReadOnly="True"
                                     Visibility="{Binding PreviewIsText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     FontFamily="Consolas" FontSize="11"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" Height="200"
                                     Background="Transparent" BorderThickness="0"/>

                            <!-- 图片预览 -->
                            <ScrollViewer Visibility="{Binding PreviewIsImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          Height="250">
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                       MaxWidth="600" MaxHeight="240"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="#FFF0F8FF" Padding="10,6" CornerRadius="4" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="{Binding LoadStatus}" FontSize="11" Foreground="{StaticResource ICDSubText}" VerticalAlignment="Center"/>
                <TextBlock Text="支持 FFU/VHDX/VHD/IMG 格式 | 只读浏览 | 多选提取" FontSize="10"
                           Foreground="{StaticResource ICDSubText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
