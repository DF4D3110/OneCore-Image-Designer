<UserControl x:Class="OneCore_Image_Designer.Views.SxsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource IcdStartBackground}" Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SxS / CBS 工具" FontSize="26" FontWeight="Light" Foreground="{StaticResource ICDTitleForeground}"/>
            <TextBlock Text="管理 SxS 导出、系统组装与服务既有镜像。全部由本程序完成，不依赖外部工具；不与 UUP 下载流程混用。" Margin="0,6,0,18" Foreground="{StaticResource ICDSubtle}"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="随应用集成的 SxS 源码" Foreground="{StaticResource ICDSubtle}"/>
                <TextBlock Text="{Binding BundledSourceDirectory}" Margin="0,4,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding BundledSourceDirectory}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="打开源码目录" Command="{Binding OpenSourceDirectoryCommand}" Style="{StaticResource ICDToolbarButton}" Margin="0,0,8,0"/>
                <Button Content="检查源码" Command="{Binding DiscoverToolsCommand}" Style="{StaticResource ICDToolbarPrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="使用说明" Command="{Binding ShowUsageCommand}" Style="{StaticResource ICDToolbarButton}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="全部能力由本程序自带实现完成，不需要任何外部可执行文件或脚本（原来的 cbsx.exe / sxsfounder.exe / puresxs.py / *.cmd 均已移除）。目标镜像必须位于挂载的 VHD/VHDX 上。"
                       Foreground="{StaticResource ICDSubtle}"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="输入镜像（只读预览）" Foreground="{StaticResource ICDSubtle}"/>
                <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                <TextBlock Text="输出目录（仅预览，不创建）" Foreground="{StaticResource ICDSubtle}"/>
                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <Button Content="选择镜像…" Command="{Binding BrowseImageCommand}" Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,8"/>
                <Button Content="选择输出…" Command="{Binding BrowseOutputCommand}" Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,8"/>
                <Button Content="安全预检 / 预览" Command="{Binding RunPreflightCommand}" Style="{StaticResource ICDToolbarPrimaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource ICDCard}" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel><TextBlock Text="{Binding Status}" Foreground="{StaticResource ICDAccentDark}"/>
                    <ItemsControl ItemsSource="{Binding Tools}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource ICDSubtle}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" Margin="0,12,0,4" FontWeight="SemiBold"/>
                <TextBlock Text="预览输入" FontWeight="SemiBold" Margin="0,8,0,2"/>
                <ItemsControl ItemsSource="{Binding PreviewInputs}"/>
                <TextBlock Text="预览输出（目录，不执行写入）" FontWeight="SemiBold" Margin="0,8,0,2"/>
                <ItemsControl ItemsSource="{Binding PreviewOutputs}"/>
                <TextBlock Text="预检项目" FontWeight="SemiBold" Margin="0,8,0,2"/>
                <ItemsControl ItemsSource="{Binding PreflightChecks}"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource ICDCard}">
                <StackPanel><TextBlock Text="SxS 操作日志" FontSize="16" Foreground="{StaticResource ICDTitleForeground}"/>
                    <ListBox ItemsSource="{Binding LogLines}" Margin="0,8,0,0"/></StackPanel>
            </Border>
        </Grid>

        <!-- 原生流程（纯增量新增；不使用 cbsx.exe / sxsfounder.exe） -->
        <Expander Grid.Row="4" Margin="0,16,0,0" IsExpanded="False"
                  Header="原生流程（纯 C#：WCP 铺底 + CBS 装 SKU + DISM 收尾，无外部 exe）">
            <StackPanel Margin="4,8,4,4">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ICDSubtle}"
                           Text="目标必须是【挂载的 VHD/VHDX】上的镜像目录（例如 G:\Windows）。对物理盘或宿主系统盘操作会破坏系统，因此会被直接拒绝。"/>
                <TextBlock Text="镜像的 Windows 目录" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBox Text="{Binding NativeWinDir, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="skuassembly.txt（可留空 = 跳过 SKU 步骤）" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBox Text="{Binding NativeSkuAssemblyFile, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="试运行（只预检，不修改镜像）" IsChecked="{Binding NativeDryRun}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox Content="结束后捕获 install.wim（输出到上面的输出目录）" IsChecked="{Binding NativeCaptureWim}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="原生流程预检" Command="{Binding RunNativePreflightCommand}"
                            Style="{StaticResource ICDToolbarButton}" Margin="0,0,8,0"/>
                    <Button Content="执行原生流程" Command="{Binding RunNativeCommand}"
                            Style="{StaticResource ICDToolbarPrimaryButton}"/>
                </StackPanel>
                <TextBlock Text="{Binding NativeSummary}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource ICDAccentDark}"/>
            </StackPanel>
        </Expander>

        <!-- 系统组装（纯增量新增）：组件依赖图 → 组装顺序 → 交给 CBS 通道 -->
        <Expander Grid.Row="5" Margin="0,12,0,0" IsExpanded="False"
                  Header="系统组装（依赖图 → 安装顺序 → CBS 通道）">
            <StackPanel Margin="4,8,4,4">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ICDSubtle}"
                           Text="从 SxS 内容出发：先算清组件之间的依赖关系，排出安装顺序，再按镜像世代自动选 CBS 通道执行。目标镜像必须位于【挂载的 VHD/VHDX】上。"/>
                <TextBlock Text="SxS 内容目录（多个用分号分隔，例如 包目录;Manifest 目录）" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBox Text="{Binding AssemblySourceDirs, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="目标镜像的 Windows 目录（执行时需要；只算计划可留空）" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBox Text="{Binding AssemblyWinDir, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="种子包（可留空 = 用全部包节点；多个用分号分隔）" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBox Text="{Binding AssemblySeeds, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="只算计划（不修改镜像）" IsChecked="{Binding AssemblyPlanOnly}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="查看依赖图" Command="{Binding RunAssemblyGraphCommand}"
                            Style="{StaticResource ICDToolbarButton}" Margin="0,0,8,0"/>
                    <Button Content="计算并执行组装" Command="{Binding RunAssemblyCommand}"
                            Style="{StaticResource ICDToolbarPrimaryButton}"/>
                </StackPanel>
                <TextBlock Text="{Binding AssemblySummary}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource ICDAccentDark}"/>
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
