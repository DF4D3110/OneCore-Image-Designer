<UserControl x:Class="OneCore_Image_Designer.Views.SxsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource IcdStartBackground}"
             FontSize="13">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource ICDSubtle}"/>
        </Style>
        <Style x:Key="Out" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="170"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource ICDToolbarButton}">
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题 -->
            <RowDefinition Height="Auto"/>   <!-- 路由条 -->
            <RowDefinition Height="*"/>      <!-- 主体（可滚动） -->
            <RowDefinition Height="Auto"/>   <!-- 状态 -->
        </Grid.RowDefinitions>

        <!-- ═══════════ 标题 ═══════════ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="SxS / CBS 工具" FontSize="26" FontWeight="Light"
                       Foreground="{StaticResource ICDTitleForeground}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="全部功能由本程序自带实现完成，不需要任何外部可执行文件或脚本。目标镜像必须位于挂载的 VHD/VHDX 上；所有写入操作默认『试运行』。"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="使用说明" Command="{Binding ShowUsageCommand}" Style="{StaticResource ICDToolbarButton}"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══════════ 路由条（常驻） ═══════════ -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="4"
                Style="{StaticResource ICDCard}">
            <TextBlock Text="{Binding RoutingStrip}" TextWrapping="Wrap"
                       Foreground="{StaticResource ICDAccentDark}" FontWeight="SemiBold"/>
        </Border>

        <!-- ═══════════ 主体 ═══════════ -->
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── ① 目标镜像与路由 ── -->
                <Expander IsExpanded="True" Header="① 目标镜像与路由判定">
                    <StackPanel Margin="8,8,8,4">
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="填写镜像的 Windows 目录（例 G:\Windows），点『判定路由』看它走原生 CBS 还是 DISM、为什么。"/>
                        <TextBlock Text="目标镜像的 Windows 目录" Style="{StaticResource Lbl}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseTargetWinDirCommand}" Style="{StaticResource Pick}"/>
                            <TextBox Text="{Binding TargetWinDir, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <Button Content="判定路由" Command="{Binding CheckRouteCommand}" Style="{StaticResource ICDToolbarPrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- ── ② 目标 SKU ── -->
                <Expander Margin="0,10,0,0" Header="② 目标 SKU（只装这一个 edition）">
                    <StackPanel Margin="8,8,8,4">
                        <TextBlock Style="{StaticResource Hint}" Text="SKU 由装哪个 Microsoft-Windows-Editions-* 决定，只装一个。"/>
                        <TextBlock Text="SxS 内容目录（多个用分号分隔；与『系统组装』区共用）" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding SkuSourceDirs, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="架构过滤" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding SkuArchFilter, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="26" VerticalContentAlignment="Center"/>
                            <Button Content="扫描可用 SKU" Command="{Binding DiscoverSkusCommand}" Style="{StaticResource ICDToolbarButton}" Margin="12,0,0,0"/>
                            <Button Content="生成组装清单" Command="{Binding BuildSkuPlanCommand}" Style="{StaticResource ICDToolbarPrimaryButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="可用 SKU" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding AvailableSkus}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" Height="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <TextBlock Text="组装清单结果" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding SkuSummary}" Style="{StaticResource Out}"/>
                    </StackPanel>
                </Expander>

                <!-- ── ③ 原生流程 ── -->
                <Expander Margin="0,10,0,0" Header="③ 原生流程（铺底 → 装 SKU → DISM → 收尾）">
                    <StackPanel Margin="8,8,8,4">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding NativeSummary}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="架构" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NativeArch, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="语言" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NativeLang, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="语言包 .mum（可空）" Style="{StaticResource Lbl}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseNativeLanguagePackCommand}" Style="{StaticResource Pick}"/>
                            <TextBox Text="{Binding NativeLanguagePack, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="SKU 组装清单（可空；由 ② 生成并自动填入）" Style="{StaticResource Lbl}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseNativeSkuFileCommand}" Style="{StaticResource Pick}"/>
                            <TextBox Text="{Binding NativeSkuAssemblyFile, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <CheckBox Content="试运行（不修改镜像）" IsChecked="{Binding NativeDryRun}" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="预检" Command="{Binding RunNativePreflightCommand}" Style="{StaticResource ICDToolbarButton}"/>
                            <Button Content="执行" Command="{Binding RunNativeCommand}" Style="{StaticResource ICDToolbarPrimaryButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="流程结果" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding NativeSummary}" Style="{StaticResource Out}"/>
                    </StackPanel>
                </Expander>

                <!-- ── ④ 系统组装 ── -->
                <Expander Margin="0,10,0,0" Header="④ 系统组装（依赖图 → 计划 → 执行）">
                    <StackPanel Margin="8,8,8,4">
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="从 SxS 内容出发：算清组件之间的依赖关系，排出安装顺序，再交给 CBS 通道执行。源目录与 ② 共用。"/>
                        <CheckBox Content="只算计划（不修改镜像）" IsChecked="{Binding AssemblyPlanOnly}" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="查看依赖图" Command="{Binding ShowGraphCommand}" Style="{StaticResource ICDToolbarButton}"/>
                            <Button Content="计算组装计划" Command="{Binding ShowAssemblyPlanCommand}" Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,0"/>
                            <Button Content="执行组装" Command="{Binding RunAssemblyCommand}" Style="{StaticResource ICDToolbarPrimaryButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="结果" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding AssemblySummary}" Style="{StaticResource Out}"/>
                    </StackPanel>
                </Expander>

                <!-- ── ⑤ pureSxS 导出 ── -->
                <Expander Margin="0,10,0,0" Header="⑤ pureSxS 导出（C# 重写，不需要 Python）">
                    <StackPanel Margin="8,8,8,4">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding PureSummary}"/>
                        <TextBlock Text="源 .mum" Style="{StaticResource Lbl}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowsePureSourceCommand}" Style="{StaticResource Pick}"/>
                            <TextBox Text="{Binding PureSourceMum, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="导出目录" Style="{StaticResource Lbl}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowsePureOutputCommand}" Style="{StaticResource Pick}"/>
                            <TextBox Text="{Binding PureOutputDir, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <Button Content="导出" Command="{Binding RunPureExportCommand}" Style="{StaticResource ICDToolbarPrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <TextBlock Text="结果" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding PureSummary}" Style="{StaticResource Out}"/>
                    </StackPanel>
                </Expander>

                <!-- ── ⑥ 更新包 / Repair Content 解包 ── -->
                <Expander Margin="0,10,0,0" Header="⑥ 更新包与 Repair Content 解包（PSF + CAB）">
                    <StackPanel Margin="8,8,8,4">
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="更新包 = 配对 CAB（描述）+ PSF（PA30 载荷），还原需要 delta 源(base)目录。Repair Content 有硬性顺序：含 neutral-mergedcomponents 的包必须先单独解包，解完删除其 PSF/CAB，再解其余。"/>
                        <TextBlock Text="更新包文件（.cab / .psm / .wim）" Style="{StaticResource Lbl}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="选择…" Command="{Binding PickUpdatePackagesCommand}" Style="{StaticResource Pick}"/>
                            <TextBox Text="{Binding UpdatePackagePaths, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Repair Content 目录（含 cab/psf）" Style="{StaticResource Lbl}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="选择…" Command="{Binding PickRepairContentDirCommand}" Style="{StaticResource Pick}"/>
                            <TextBox Text="{Binding RepairContentDir, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="解包输出目录" Style="{StaticResource Lbl}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding PickUnpackOutDirCommand}" Style="{StaticResource Pick}"/>
                            <TextBox Text="{Binding UnpackOutDir, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="delta 源(base)目录（可空）" Style="{StaticResource Lbl}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding PickUnpackBaseDirCommand}" Style="{StaticResource Pick}"/>
                            <TextBox Text="{Binding UnpackBaseDir, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <CheckBox Content="只解析索引（不写出文件）" IsChecked="{Binding UnpackListOnly}" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="解包更新包" Command="{Binding UnpackUpdatePackagesCommand}" Style="{StaticResource ICDToolbarButton}"/>
                            <Button Content="按顺序解包 Repair Content" Command="{Binding UnpackRepairContentCommand}" Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,0"/>
                            <Button Content="检验存储" Command="{Binding InspectStoreCommand}" Style="{StaticResource ICDToolbarButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="结果" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding UnpackSummary}" Style="{StaticResource Out}"/>
                    </StackPanel>
                </Expander>


            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════ 状态栏 ═══════════ -->
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{StaticResource ICDTitleForeground}"/>
    </Grid>
</UserControl>
