<Application x:Class="OneCore_Image_Designer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 转换器 -->
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" xmlns:converters="clr-namespace:OneCore_Image_Designer.Converters"/>
        <converters:PartitionColorConverter x:Key="PartitionColorConverter" xmlns:converters="clr-namespace:OneCore_Image_Designer.Converters"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" xmlns:converters="clr-namespace:OneCore_Image_Designer.Converters"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" xmlns:converters="clr-namespace:OneCore_Image_Designer.Converters"/>

        <!-- ════════════════════════════════════════════════════════════
             ICD Classic（LightTheme）色板 —— 逐项取自 ICDUI.dll
             Resources/Dictionaries/common/colors.baml + brushes.baml 实证：
             ICDThemeBackground=White / ICDBlue=#007ACC / InputFocusBlue=#0C9AF8
             ICDLightBlue=#D8F6FE / EditorSelectedControlBackground=#CDE6F7
             SaveIconBlue=#00539C / EditorTitle=#429DDA
             页签选中高亮 #39ADFB（tabstyles.baml）
             ════════════════════════════════════════════════════════════ -->
        <Color x:Key="ICDThemeBackgroundColor">White</Color>
        <Color x:Key="ICDThemeBackgroundColor2Color">#FFF0F4F9</Color>
        <Color x:Key="ICDThemeForegroundColor">#FF007ACC</Color>
        <Color x:Key="ICDBlueColor">#FF007ACC</Color>
        <Color x:Key="ICDLightBlueColor">#FFD8F6FE</Color>

        <SolidColorBrush x:Key="IcdStartBackground" Color="White"/>
        <SolidColorBrush x:Key="ICDAccent" Color="#FF007ACC"/>
        <SolidColorBrush x:Key="ICDAccentBright" Color="#FF39ADFB"/>
        <SolidColorBrush x:Key="ICDAccentDark" Color="#FF00539C"/>
        <SolidColorBrush x:Key="ICDSurface" Color="White"/>
        <SolidColorBrush x:Key="ICDSurfaceAlt" Color="#FFF0F4F9"/>
        <SolidColorBrush x:Key="ICDForeground" Color="#FF1F1F1F"/>
        <SolidColorBrush x:Key="ICDSubtle" Color="#FF6A6A6A"/>
        <SolidColorBrush x:Key="ICDTitleForeground" Color="#FF007ACC"/>

        <!-- 主壳通用键（浅色主题） -->
        <SolidColorBrush x:Key="AppBackground" Color="#FFF0F4F9"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFD2DCE6"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FF1F1F1F"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF6A6A6A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF007ACC"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFD8F6FE"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF00539C"/>

        <SolidColorBrush x:Key="MenuBackground" Color="White"/>
        <SolidColorBrush x:Key="MenuForeground" Color="#FF1F1F1F"/>
        <SolidColorBrush x:Key="TabStripBackground" Color="#FFDCE6F1"/>
        <SolidColorBrush x:Key="StatusBarBackground" Color="#FFF0F4F9"/>
        <SolidColorBrush x:Key="ProgressPanelBackground" Color="#FFE8F4FD"/>

        <!-- ════════ 兼容旧键（各步骤 XAML 大量引用，保留别名） ════════ -->
        <SolidColorBrush x:Key="ICDBlue" Color="#FF007ACC"/>
        <SolidColorBrush x:Key="ICDLightBlue" Color="#FFD8F6FE"/>
        <SolidColorBrush x:Key="ICDDarkBlue" Color="#FF00539C"/>
        <SolidColorBrush x:Key="ICDBackground" Color="#FFF5F5F5"/>
        <SolidColorBrush x:Key="ICDCardBackground" Color="White"/>
        <SolidColorBrush x:Key="ICDBorder" Color="#FFD2DCE6"/>
        <SolidColorBrush x:Key="ICDText" Color="#FF1F1F1F"/>
        <SolidColorBrush x:Key="ICDSubText" Color="#FF6A6A6A"/>

        <!-- ════════ 按钮 ════════ -->
        <Style x:Key="ICDButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ICDAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0C9AF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFCCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ICDSecondaryButton" TargetType="Button" BasedOn="{StaticResource ICDButton}">
            <Setter Property="Background" Value="#FFDCE6F1"/>
            <Setter Property="Foreground" Value="{StaticResource ICDForeground}"/>
        </Style>

        <Style x:Key="ICDToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ICDForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ICDLightBlue}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ICDAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ICDToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource ICDToolbarButton}">
            <Setter Property="Background" Value="{StaticResource ICDAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ICDAccent}"/>
        </Style>

        <Style x:Key="ICDCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ICDSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- ════════ 首页分组标题（Create / Recent projects） ════════ -->
        <Style x:Key="IcdSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="{StaticResource ICDTitleForeground}"/>
            <Setter Property="Margin" Value="2,0,0,12"/>
        </Style>

        <!-- 旧键名兼容（其他页引用） -->
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource IcdSectionHeader}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ICDForeground}"/>
            <Setter Property="Margin" Value="2,10,0,10"/>
        </Style>

        <!-- ════════ TabControl：ICD 浅色页签条，选中页签白底+亮蓝顶线，× 关闭钮 ════════ -->
        <Style x:Key="AppTabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF5A6B7E"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="&#xE8BB;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22007ACC"/>
                                <Setter Property="Foreground" Value="#FFC42B1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="AppTabItemTemplate" TargetType="TabItem">
            <Border x:Name="headBd" Background="#FFC9D9EC" BorderBrush="#FFB3C6DD" BorderThickness="0,0,1,0"
                    Padding="12,7" MinWidth="130" MaxWidth="240">
                <StackPanel Orientation="Horizontal">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    <Button x:Name="closeBt" Style="{StaticResource AppTabCloseButton}" Margin="10,-2,0,0"
                            Visibility="Collapsed"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="headBd" Property="Background" Value="White"/>
                    <Setter TargetName="headBd" Property="BorderBrush" Value="{StaticResource ICDAccentBright}"/>
                    <Setter TargetName="headBd" Property="BorderThickness" Value="0,3,1,0"/>
                    <Setter Property="Foreground" Value="{StaticResource ICDForeground}"/>
                    <Setter TargetName="closeBt" Property="Foreground" Value="#FF5A6B7E"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="headBd" Property="Background" Value="#FFDDEAF8"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="False">
                    <Setter TargetName="closeBt" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="AppTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#FF33475C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template" Value="{StaticResource AppTabItemTemplate}"/>
        </Style>

        <Style x:Key="AppTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource AppBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AppTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource TabStripBackground}"
                                    BorderBrush="#FFB3C6DD" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="2,2,0,0" KeyboardNavigation.TabIndex="1"/>
                            </Border>
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AppTabHeaderTemplate">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        <!-- 菜单深色风格（现为浅色，保持键名兼容） -->
        <Style TargetType="Menu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Menu">
                        <Border Background="{TemplateBinding Background}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource MenuForeground}"/>
        </Style>

        <!-- 全局窗口字体：所有 Window（含独立工具窗口）统一中文字体，避免方块 -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
    </Application.Resources>
</Application>
