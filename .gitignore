# addonkit is a bundled copy of Microsoft iot-adk-addonkit 17763-v7.
# Its directories and files must ship with the repository, so the wildcard
# rules above (bin/, **/build/, *.tmp, ...) must NOT match inside it.
!addonkit/**
!addonkit/**/Build/
!addonkit/**/bin/

# Native servicing build outputs, produced by Source/Native/build-servicing.ps1
# from Source/Native/**. They are rebuildable, so they are never committed.
Source/Native/Output/

# Local working notes: kept on the author's machine, never part of the repo.
CBS_TECHNICAL_NOTES.md
CBS_SESSION_REVIEW.md
