<?xml version="1.0" encoding="utf-8"?>
<DeviceLayout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/embedded/2004/10/ImageUpdate">
  <!-- CPUTYPE:SV:SOC:DEVICE:RELEASETYPE:MAJOR:MINOR - must use C#-RegEx syntax in wild cards -->
  <Scope>x86:intel:(cht|sofia):.+:.+:.+:.+</Scope>

  <Partitions>
    <Partition>
      <Name>DPP</Name>
      <!-- <Type>0x0B</Type> -->
      <Type>{ebd0a0a2-b9e5-4433-87c0-68b6b72699c7}</Type>
      <TotalSectors>*ANY*</TotalSectors>
      <FileSystem>*ANY*</FileSystem>
      <RequiredToFlash>true</RequiredToFlash>
      <Optional>true</Optional>
    </Partition>
    <Partition>
      <Name>EFI</Name>
      <FileSystem>FAT</FileSystem>
      <TotalSectors>*ANY*</TotalSectors>
      <!-- <Type>0x07</Type> -->
      <Type>{C12A7328-F81F-11D2-BA4B-00A0C93EC93B}</Type>
      <Bootable>*ANY*</Bootable>
      <RequiredToFlash>true</RequiredToFlash>
      <Optional>true</Optional>
    </Partition>
    <Partition>
      <Name>EFIESP</Name>
      <FileSystem>FAT</FileSystem>
      <TotalSectors>*ANY*</TotalSectors>
      <!-- <Type>0x07</Type> -->
      <Type>{ebd0a0a2-b9e5-4433-87c0-68b6b72699c7}</Type>
      <Bootable>*ANY*</Bootable>
      <ByteAlignment>*ANY*</ByteAlignment>
      <RequiredToFlash>true</RequiredToFlash>
    </Partition>
    <Partition>
      <Name>BP</Name>
      <TotalSectors>*ANY*</TotalSectors>
      <!--  <Type>0x4d</Type> -->
      <Type>{ebd0a0a2-b9e5-4433-87c0-68b6b72699c7}</Type>
      <Bootable>*ANY*</Bootable>
      <RequiredToFlash>true</RequiredToFlash>
      <SingleSectorAlignment>true</SingleSectorAlignment>
      <Optional>true</Optional>
    </Partition>
    <Partition>
      <Name>MainOS</Name>
      <!-- <Type>0x07</Type> -->
      <Type>{ebd0a0a2-b9e5-4433-87c0-68b6b72699c7}</Type>
      <ByteAlignment>*ANY*</ByteAlignment>
      <RequiresCompression>*ANY*</RequiresCompression>
      <MinFreeSectors>*ANY*</MinFreeSectors>
      <TotalSectors>*ANY*</TotalSectors>
      <ClusterSize>*ANY*</ClusterSize>
      <FileSystem>NTFS</FileSystem>
    </Partition>
    <Partition>
      <Name>Data</Name>
      <!-- <Type>0x07</Type> -->
      <Type>{ebd0a0a2-b9e5-4433-87c0-68b6b72699c7}</Type>
      <ByteAlignment>*ANY*</ByteAlignment>
      <ClusterSize>*ANY*</ClusterSize>
      <TotalSectors>*ANY*</TotalSectors>
      <UseAllSpace>true</UseAllSpace>
      <FileSystem>NTFS</FileSystem>
      <Position>-1</Position>
    </Partition>
  </Partitions>
  <SectorSize>512</SectorSize>
  <ChunkSize>*ANY*</ChunkSize>
  <DefaultPartitionByteAlignment>*ANY*</DefaultPartitionByteAlignment>
</DeviceLayout>

