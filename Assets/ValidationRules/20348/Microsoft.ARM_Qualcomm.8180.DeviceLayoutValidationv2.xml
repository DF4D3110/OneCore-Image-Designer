    <RulesSectorSize>512</RulesSectorSize>
    <!-- LUN0 -->
    <Stores>
	    <Store>
            <Id>{AE420040-13DD-41F2-AE7F-0DC35854C8D7}</Id>
            <StoreType>MainOSStore</StoreType>
	        <Partitions>
