<Window x:Class="OneCore_Image_Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:OneCore_Image_Designer.Helpers"
        xmlns:local="clr-namespace:OneCore_Image_Designer"
        xmlns:vm="clr-namespace:OneCore_Image_Designer.ViewModels"
        xmlns:vmOEM="clr-namespace:OneCore_Image_Designer.ViewModels.OEMInput"
        xmlns:vmDL="clr-namespace:OneCore_Image_Designer.ViewModels.DeviceLayout"
        xmlns:vmIB="clr-namespace:OneCore_Image_Designer.ViewModels.ImageBuild"
        xmlns:vmSR="clr-namespace:OneCore_Image_Designer.ViewModels.SystemReconstruct"
        xmlns:vmFB="clr-namespace:OneCore_Image_Designer.ViewModels.FFUBrowser"
        xmlns:vmCBS="clr-namespace:OneCore_Image_Designer.ViewModels.Cbs"
        xmlns:views="clr-namespace:OneCore_Image_Designer.Views"
        xmlns:viewsOEM="clr-namespace:OneCore_Image_Designer.Views.OEMInput"
        xmlns:viewsDL="clr-namespace:OneCore_Image_Designer.Views.DeviceLayout"
        xmlns:viewsIB="clr-namespace:OneCore_Image_Designer.Views.ImageBuild"
        xmlns:viewsSR="clr-namespace:OneCore_Image_Designer.Views.SystemReconstruct"
        xmlns:viewsFB="clr-namespace:OneCore_Image_Designer.Views.FFUBrowser"
        xmlns:viewsCBS="clr-namespace:OneCore_Image_Designer.Views.Cbs"
        xmlns:services="clr-namespace:OneCore_Image_Designer.Services"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="760" Width="1200"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        Icon="Assets/app.ico">
    <Window.Resources>
        <helpers:AppTabContentTemplateSelector x:Key="AppTabContentTemplateSelector"/>
        <DataTemplate DataType="{x:Type vm:StartPageViewModel}">
            <views:StartPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOEM:OEMInputDesignerViewModel}">
            <viewsOEM:OEMInputDesignerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDL:DeviceLayoutPreviewViewModel}">
            <viewsDL:DeviceLayoutPreviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmDL:DeviceLayoutEditorViewModel}">
            <viewsDL:DeviceLayoutEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmCBS:CbsBuildViewModel}">
            <viewsCBS:CbsBuildView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmIB:ImageBuildViewModel}">
            <viewsIB:ImageBuildView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSR:SystemReconstructViewModel}">
            <viewsSR:SystemReconstructView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSR:FullReconstructViewModel}">
            <viewsSR:FullReconstructView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSR:SelectReconstructViewModel}">
            <viewsSR:SelectReconstructView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmFB:FFUBrowserViewModel}">
            <viewsFB:FFUBrowserView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UupViewModel}">
            <views:UupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SxsViewModel}">
            <views:SxsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddonKitViewModel}">
            <views:AddonKitView/>
        </DataTemplate>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- 菜单栏（ICD 式：文件 / 工具 / 帮助） -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource MenuBackground}" Foreground="{StaticResource MenuForeground}"
              FontSize="12" Padding="4,2">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建工程" InputGestureText="Ctrl+N"
                          Command="{Binding OpenOemInputCommand}" CommandParameter="new"/>
                <MenuItem Header="打开工程…" InputGestureText="Ctrl+O"
                          Command="{Binding OpenOemInputCommand}" CommandParameter="open"/>
                <MenuItem Header="直接打开 OEMInput.xml…"
                          Command="{Binding OpenOemInputCommand}" CommandParameter="openxml"/>
                <Separator/>
                <MenuItem Header="关闭工程" Command="{Binding CloseCurrentProjectCommand}"/>
                <MenuItem Header="保存工程" InputGestureText="Ctrl+S"
                          Command="{Binding SaveProjectCommand}"/>
                <Separator/>
                <MenuItem Header="退出" InputGestureText="Alt+F4" Command="{Binding ExitAppCommand}"/>
            </MenuItem>
            <MenuItem Header="功能(_G)">
                <MenuItem Header="OEMInput 设计器" Command="{Binding GotoOemInputCommand}"/>
                <MenuItem Header="设备磁盘布局预览" Command="{Binding GotoDeviceLayoutCommand}"/>
                <MenuItem Header="设备布局创建（FM + CAB）" Command="{Binding OpenDeviceLayoutBuilderCommand}"/>
                <MenuItem Header="镜像构建" Command="{Binding GotoImageBuildCommand}"/>
                <MenuItem Header="系统重构" Command="{Binding GotoSystemReconstructCommand}"/>
                <Separator/>
                <MenuItem Header="FFU 文件浏览器" Command="{Binding GotoFfuBrowserCommand}"/>
                <Separator/>
                <MenuItem Header="UUP 更新查询与下载" Command="{Binding OpenUupCommand}"/>
                <MenuItem Header="SxS / CBS 工具" Command="{Binding OpenSxsCommand}"/>
                <MenuItem Header="addonkit 工作区" Command="{Binding OpenAddonKitCommand}"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="离线注册表编辑器" Command="{Binding OpenToolRegistryCommand}"/>
                <MenuItem Header="驱动提取与整理" Command="{Binding OpenToolDriverCommand}"/>
                <MenuItem Header="UEFI 固件解析器" Command="{Binding OpenToolFirmwareCommand}"/>
                <Separator/>
                <MenuItem Header="WinSxS Hash 计算器" Command="{Binding OpenToolHashCommand}"/>
                <MenuItem Header="包依赖关系分析器" Command="{Binding OpenToolDependencyCommand}"/>
                <MenuItem Header="组件存储完整性校验" Command="{Binding OpenToolStoreVerifyCommand}"/>
                <Separator/>
                <MenuItem Header="ADK 工具下载 / addonkit…" Command="{Binding OpenAdkToolCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 OneCore Image Designer" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusBarBackground}" Padding="12,5"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="v1.0" FontSize="11"
                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 全局进度条 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ProgressPanelBackground}" Padding="12,8"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}"
                Visibility="{Binding Source={x:Static services:GlobalProgressService.Instance}, Path=IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Source={x:Static services:GlobalProgressService.Instance}, Path=ProgressText}"
                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="取消" Padding="16,4" FontSize="11"
                            Command="{Binding Source={x:Static services:GlobalProgressService.Instance}, Path=CancelCommand}"
                            Visibility="{Binding Source={x:Static services:GlobalProgressService.Instance}, Path=CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:GlobalProgressService.Instance}, Path=StatusText}"
                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static services:GlobalProgressService.Instance}, Path=DetailText}"
                               FontSize="11" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Value="{Binding Source={x:Static services:GlobalProgressService.Instance}, Path=Progress, Mode=OneWay}"
                                 Minimum="0" Maximum="100" Height="6" Margin="0,6,0,0"
                                 IsIndeterminate="{Binding Source={x:Static services:GlobalProgressService.Instance}, Path=IsIndeterminate, Mode=OneWay}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 标签页容器 -->
        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                    Style="{StaticResource AppTabControl}"
                    ItemTemplate="{StaticResource AppTabHeaderTemplate}"
                    Background="Transparent" BorderThickness="0">
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:AppTabViewModel}">
                    <ContentControl Content="{Binding Content}"
                                    ContentTemplateSelector="{StaticResource AppTabContentTemplateSelector}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
