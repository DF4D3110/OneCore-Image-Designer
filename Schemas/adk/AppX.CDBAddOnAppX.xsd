<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://schemas.microsoft.com/embedded/2004/10/ImageUpdate" elementFormDefault="qualified" xmlns="http://schemas.microsoft.com/embedded/2004/10/ImageUpdate" xmlns:mstns="http://schemas.microsoft.com/embedded/2004/10/ImageUpdate" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="AppXPackageType">
    <xs:all>
      <xs:element name="Payload" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="PayloadItem" type="PayloadItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Dependencies" type="DependencyType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AppXBundleChildren" type="AppXBundleChildType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="LicenseData" minOccurs="0" maxOccurs="1"/>
    </xs:all>
    <xs:attribute name="FamilyName" type="xs:string" />
    <xs:attribute name="FullName" type="xs:string" />
    <xs:attribute name="OwnerType" type="xs:string" />
    <xs:attribute name="PreferStub" type="xs:boolean" use="optional" />
    <xs:attribute name="Region" type="xs:string" use="optional" />

    <xs:attribute name="AppXPackageType">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="(AppXMain|AppXBundle|AppXOptional|AppXFramework)"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="AppXBundleChildType">
    <xs:sequence>
      <xs:element name="AppXBundleChild" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="FullName" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DependencyType">
      <xs:sequence>
        <xs:element name="Dependency" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <!-- Consider making this a choice so there can only be dependencies on FullName or FamilyName -->
            <xs:attribute name="FullName" type="xs:string" use="optional"/>
            <xs:attribute name="FamilyName" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>

  <xs:complexType name="AppXType">
    <xs:all>
      <xs:element name="AppXPackages" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Package" type="AppXPackageType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="ConditionalAppXPackages" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ConditionalAppXPackage" type="ConditionalFeatureType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>
</xs:schema>
