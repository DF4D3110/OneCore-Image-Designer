#!/bin/sh
# 产品线边界守卫：desktop 与 WCOS/Phone 两侧不得互相引用。
# 启用方式（在仓库根执行一次）：
#     git config core.hooksPath .githooks
# 跳过本次检查（确有把握时）：
#     git commit --no-verify
#
# 为什么放在提交钩子而不是 MSBuild：构建目标在每台机器上都要跑，
# 而执行策略（ExecutionPolicy）在有的机器上会拦住 .ps1，导致构建无故失败。
# 钩子是本地一次性配置，失败也只拦提交，不拦构建。

set -e

repo_root=$(git rev-parse --show-toplevel)
guard="$repo_root/check-product-lines.ps1"

if [ ! -f "$guard" ]; then
    echo "[pre-commit] 找不到 check-product-lines.ps1，跳过边界检查"
    exit 0
fi

# 依次尝试 pwsh(7) / powershell(5.1)；都不可用则跳过并提示
if command -v pwsh >/dev/null 2>&1; then
    runner="pwsh"
elif command -v powershell.exe >/dev/null 2>&1; then
    runner="powershell.exe"
elif command -v powershell >/dev/null 2>&1; then
    runner="powershell"
else
    echo "[pre-commit] 未找到 PowerShell，跳过边界检查"
    exit 0
fi

"$runner" -NoProfile -ExecutionPolicy Bypass -File "$guard"
