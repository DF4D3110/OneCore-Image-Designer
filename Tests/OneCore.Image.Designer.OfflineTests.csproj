<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneCore Image Designer.csproj" />
    <ProjectReference Include="..\ThirdParty\UUPMediaCreator\src\Cabinet\Cabinet.csproj" />
    <ProjectReference Include="..\ThirdParty\UUPMediaCreator\src\UnifiedUpdatePlatform.Services.WindowsUpdate\UnifiedUpdatePlatform.Services.WindowsUpdate.csproj" />
  </ItemGroup>
  <Target Name="AliasVendoredCabinetForTests" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Update="@(ReferencePath)" Condition="'%(Filename)' == 'Cabinet'">
        <Aliases>UupCabinet</Aliases>
      </ReferencePath>
      <ReferencePathWithRefAssemblies Update="@(ReferencePathWithRefAssemblies)" Condition="'%(Filename)' == 'Cabinet'">
        <Aliases>UupCabinet</Aliases>
      </ReferencePathWithRefAssemblies>
    </ItemGroup>
  </Target>
</Project>
